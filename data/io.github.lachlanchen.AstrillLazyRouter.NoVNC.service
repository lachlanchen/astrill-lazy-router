[Unit]
Description=Astrill Lazy Router isolated noVNC controller

[Service]
Type=simple
EnvironmentFile=-%h/.config/astrill-lazy/novnc.env
ExecStart="@ROOT@/scripts/run-novnc-debug.sh"
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
