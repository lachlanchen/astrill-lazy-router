#!/bin/sh

# Boot runner for one fixed application-specific network identity.

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

fail() {
    printf 'astrill-lazy-profile-runner: %s\n' "$*" >&2
    exit 1
}

is_uint() {
    case ${1:-} in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

find_gnome_session() {
    desktop_uid=$1
    pgrep -u "$desktop_uid" -x gnome-shell 2>/dev/null |
        while read -r candidate; do
            [ -r "/proc/$candidate/environ" ] || continue
            tr '\000' '\n' < "/proc/$candidate/environ" 2>/dev/null |
                grep -q '^DBUS_SESSION_BUS_ADDRESS=' || continue
            printf '%s\n' "$candidate"
            break
        done
}

[ "$(id -u)" -eq 0 ] || fail "this runner must be started by the system manager"
[ "$#" -ge 4 ] ||
    fail "usage: astrill-lazy-profile-runner PROFILE PARENT UID EXECUTABLE [ARG ...]"

profile=$1
parent=$2
desktop_uid=$3
executable=$4
shift 4

helper=${ASTRILL_LAZY_NETNS_HELPER:-/usr/local/libexec/astrill-lazy-netns}
[ -x "$helper" ] || fail "network helper is not installed: $helper"
if ! is_uint "$desktop_uid" || [ "$desktop_uid" -lt 1000 ]; then
    fail "desktop UID must be an integer of at least 1000"
fi

"$helper" prepare "$profile" "$parent"

session_pid=
while [ -z "$session_pid" ]; do
    session_pid=$(find_gnome_session "$desktop_uid" || true)
    [ -n "$session_pid" ] || sleep 5
done

exec "$helper" launch \
    "$profile" "$desktop_uid" "$session_pid" "$executable" "$@"
