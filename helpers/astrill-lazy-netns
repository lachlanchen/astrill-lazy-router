#!/bin/sh

# Root helper for application-specific network identities.

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

STATE_DIR=/run/astrill-lazy
BUSYBOX=/usr/bin/busybox

fail() {
    printf 'astrill-lazy-netns: %s\n' "$*" >&2
    exit 1
}

is_uint() {
    case ${1:-} in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

valid_profile() {
    value=${1:-}
    [ -n "$value" ] && [ "${#value}" -le 10 ] || return 1
    case $value in *[!a-z0-9]*) return 1 ;; esac
}

valid_interface() {
    value=${1:-}
    [ -n "$value" ] && [ "${#value}" -le 15 ] || return 1
    case $value in *[!A-Za-z0-9_.:-]*) return 1 ;; esac
}

valid_ipv4() {
    printf '%s\n' "${1:-}" | awk -F. '
        NF != 4 { exit 1 }
        {
            for (i = 1; i <= 4; i++) {
                if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
            }
        }
    '
}

valid_domain() {
    printf '%s\n' "${1:-}" | awk -F. '
        BEGIN { valid = 1 }
        {
            if (length($0) < 1 || length($0) > 253 || NF < 2) valid = 0
            for (i = 1; i <= NF; i++) {
                if (length($i) < 1 || length($i) > 63) valid = 0
                if ($i !~ /^[a-z0-9]$/ &&
                    $i !~ /^[a-z0-9][a-z0-9-]*[a-z0-9]$/) valid = 0
            }
        }
        END { exit(NR == 1 && valid ? 0 : 1) }
    '
}

valid_host_name() {
    value=${1:-}
    [ -n "$value" ] && [ "${#value}" -le 253 ] || return 1
    case $value in *[!A-Za-z0-9_.-]*) return 1 ;; esac
}

valid_port_list() {
    printf '%s\n' "${1:-}" | awk -F, '
        NF < 1 || NF > 8 { exit 1 }
        {
            for (i = 1; i <= NF; i++) {
                if ($i !~ /^[0-9]+$/ || $i < 1 || $i > 65535) exit 1
            }
        }
    '
}

profile_mac() {
    profile=$1
    checksum=$(printf '%s' "$profile" | cksum | awk '{ print $1 }')
    printf '02:41:4c:%02x:%02x:%02x\n' \
        "$((checksum / 65536 % 256))" \
        "$((checksum / 256 % 256))" \
        "$((checksum % 256))"
}

namespace_for() {
    printf 'al-%s\n' "$1"
}

state_file_for() {
    printf '%s/%s.ip\n' "$STATE_DIR" "$1"
}

pid_file_for() {
    printf '%s/%s.udhcpc.pid\n' "$STATE_DIR" "$1"
}

dhcp_pid_for() (
    pid_file=$1
    pid=$(cat "$pid_file" 2>/dev/null || printf 0)
    is_uint "$pid" && [ "$pid" -gt 1 ] || exit 1
    [ "$(readlink "/proc/$pid/exe" 2>/dev/null || true)" = "$BUSYBOX" ] ||
        exit 1
    tr '\000' '\n' < "/proc/$pid/cmdline" 2>/dev/null |
        grep -Fxq udhcpc || exit 1
    tr '\000' '\n' < "/proc/$pid/cmdline" 2>/dev/null |
        grep -Fxq "$pid_file" || exit 1
    printf '%s\n' "$pid"
)

write_profile_resolver() {
    namespace=$1
    dhcp_servers=${2:-}
    configured_servers=${ASTRILL_LAZY_PROFILE_DNS:-}
    resolv_file="/etc/netns/$namespace/resolv.conf"
    server_count=0

    if [ -n "$configured_servers" ] && [ "${#configured_servers}" -gt 128 ]; then
        fail "profile DNS configuration is too long"
    fi
    : > "$resolv_file"
    set -f
    if [ -n "$configured_servers" ]; then
        for server in $configured_servers; do
            valid_ipv4 "$server" || fail "profile DNS contains an invalid IPv4 address"
            server_count=$((server_count + 1))
            [ "$server_count" -le 3 ] || fail "profile DNS supports at most three servers"
            printf 'nameserver %s\n' "$server" >> "$resolv_file"
        done
    else
        for server in $dhcp_servers; do
            if valid_ipv4 "$server"; then
                server_count=$((server_count + 1))
                [ "$server_count" -le 3 ] || break
                printf 'nameserver %s\n' "$server" >> "$resolv_file"
            fi
        done
    fi
    set +f
    [ -s "$resolv_file" ] ||
        printf 'nameserver 192.168.1.1\n' > "$resolv_file"
    chmod 644 "$resolv_file"
}

mask_prefix() {
    case ${1:-} in
        255.0.0.0) printf 8 ;;
        255.128.0.0) printf 9 ;;
        255.192.0.0) printf 10 ;;
        255.224.0.0) printf 11 ;;
        255.240.0.0) printf 12 ;;
        255.248.0.0) printf 13 ;;
        255.252.0.0) printf 14 ;;
        255.254.0.0) printf 15 ;;
        255.255.0.0) printf 16 ;;
        255.255.128.0) printf 17 ;;
        255.255.192.0) printf 18 ;;
        255.255.224.0) printf 19 ;;
        255.255.240.0) printf 20 ;;
        255.255.248.0) printf 21 ;;
        255.255.252.0) printf 22 ;;
        255.255.254.0) printf 23 ;;
        255.255.255.0) printf 24 ;;
        255.255.255.128) printf 25 ;;
        255.255.255.192) printf 26 ;;
        255.255.255.224) printf 27 ;;
        255.255.255.240) printf 28 ;;
        255.255.255.248) printf 29 ;;
        255.255.255.252) printf 30 ;;
        *) return 1 ;;
    esac
}

cleanup_profile() {
    profile=$1
    namespace=$(namespace_for "$profile")
    pid_file=$(pid_file_for "$profile")
    pid=$(dhcp_pid_for "$pid_file" 2>/dev/null || printf 0)
    if [ "$pid" -gt 1 ]; then
        kill "$pid" 2>/dev/null || true
    fi
    if ip netns list | awk '{print $1}' | grep -Fxq "$namespace"; then
        profile_pids=$(ip netns pids "$namespace" 2>/dev/null || true)
        if [ -n "$profile_pids" ]; then
            for profile_pid in $profile_pids; do
                if is_uint "$profile_pid"; then
                    kill "$profile_pid" 2>/dev/null || true
                fi
            done
            sleep 1
            profile_pids=$(ip netns pids "$namespace" 2>/dev/null || true)
            for profile_pid in $profile_pids; do
                if is_uint "$profile_pid"; then
                    kill -KILL "$profile_pid" 2>/dev/null || true
                fi
            done
        fi
    fi
    ip netns delete "$namespace" 2>/dev/null || true
    rm -f "$(state_file_for "$profile")" "$pid_file"
    rm -f "/etc/netns/$namespace/resolv.conf" "/etc/netns/$namespace/hosts"
    rmdir "/etc/netns/$namespace" 2>/dev/null || true
    if ip netns list | awk '{print $1}' | grep -Fxq "$namespace"; then
        fail "application network profile could not be removed"
    fi
}

pin_profile_hosts() {
    profile=${1:-}
    shift || true
    valid_profile "$profile" || fail "invalid profile"
    if [ "$#" -lt 2 ] || [ "$#" -gt 128 ] || [ "$(( $# % 2 ))" -ne 0 ]; then
        fail "one to 64 domain and IPv4 pairs are required"
    fi
    namespace=$(namespace_for "$profile")
    hosts_dir="/etc/netns/$namespace"
    ip netns list | awk '{print $1}' | grep -Fxq "$namespace" ||
        fail "application network profile is not prepared"
    [ -d "$hosts_dir" ] || fail "profile hosts directory is unavailable"

    hosts_tmp=$(mktemp "$STATE_DIR/$profile.hosts.XXXXXX") ||
        fail "could not allocate profile hosts file"
    trap 'rm -f "$hosts_tmp"' EXIT HUP INT TERM
    host_name=$(hostname)
    valid_host_name "$host_name" || fail "system host name is invalid"
    printf '127.0.0.1 localhost\n127.0.1.1 %s\n' "$host_name" > "$hosts_tmp"
    printf '::1 localhost ip6-localhost ip6-loopback\n' >> "$hosts_tmp"
    while [ "$#" -gt 0 ]; do
        domain=$1
        address=$2
        shift 2
        valid_domain "$domain" || fail "profile hosts contains an invalid domain"
        valid_ipv4 "$address" || fail "profile hosts contains an invalid IPv4 address"
        printf '%s %s\n' "$address" "$domain" >> "$hosts_tmp"
    done
    chmod 644 "$hosts_tmp"
    mv -f "$hosts_tmp" "$hosts_dir/hosts"
    trap - EXIT HUP INT TERM
}

restrict_profile() {
    profile=${1:-}
    ports=${2:-}
    shift 2
    valid_profile "$profile" || fail "invalid profile"
    valid_port_list "$ports" || fail "invalid allowed TCP ports"
    if [ "$#" -lt 1 ] || [ "$#" -gt 64 ]; then
        fail "one to 64 allowed IPv4 destinations are required"
    fi
    namespace=$(namespace_for "$profile")
    ip netns list | awk '{print $1}' | grep -Fxq "$namespace" ||
        fail "application network profile is not prepared"
    command -v iptables >/dev/null 2>&1 || fail "iptables is unavailable"

    for address in "$@"; do
        valid_ipv4 "$address" || fail "invalid allowed IPv4 destination"
    done
    dns_servers=$(awk '$1 == "nameserver" { print $2 }' \
        "/etc/netns/$namespace/resolv.conf" 2>/dev/null || true)
    [ -n "$dns_servers" ] || fail "profile DNS is unavailable"
    for server in $dns_servers; do
        valid_ipv4 "$server" || fail "profile DNS contains an invalid IPv4 address"
    done

    ip netns exec "$namespace" iptables -w 5 -P OUTPUT ACCEPT
    ip netns exec "$namespace" iptables -w 5 -F OUTPUT
    ip netns exec "$namespace" iptables -w 5 -A OUTPUT -o lo -j ACCEPT
    ip netns exec "$namespace" iptables -w 5 -A OUTPUT \
        -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    ip netns exec "$namespace" iptables -w 5 -A OUTPUT \
        -p udp --sport 68 --dport 67 -j ACCEPT
    for server in $dns_servers; do
        ip netns exec "$namespace" iptables -w 5 -A OUTPUT \
            -d "$server" -p udp --dport 53 -j ACCEPT
        ip netns exec "$namespace" iptables -w 5 -A OUTPUT \
            -d "$server" -p tcp --dport 53 -j ACCEPT
    done
    old_ifs=$IFS
    IFS=,
    for address in "$@"; do
        for port in $ports; do
            ip netns exec "$namespace" iptables -w 5 -A OUTPUT \
                -d "$address" -p tcp --dport "$port" -j ACCEPT
        done
    done
    IFS=$old_ifs
    ip netns exec "$namespace" iptables -w 5 -P OUTPUT DROP
    ip netns exec "$namespace" iptables -w 5 -S OUTPUT |
        grep -Fxq -- '-P OUTPUT DROP' || fail "could not restrict profile egress"
}

execute_profile() {
    profile=${1:-}
    user_id=${2:-}
    working_dir=${3:-}
    executable=${4:-}
    shift 4
    valid_profile "$profile" || fail "invalid profile"
    if ! is_uint "$user_id" || [ "$user_id" -lt 1000 ]; then
        fail "invalid desktop user"
    fi
    if ! is_uint "${SUDO_UID:-}" || [ "$SUDO_UID" -lt 1000 ] ||
        [ "$user_id" -ne "$SUDO_UID" ]; then
        fail "command user does not match the invoking desktop user"
    fi
    case $working_dir in /*) ;; *) fail "working directory must be absolute" ;; esac
    [ -d "$working_dir" ] || fail "working directory does not exist"
    case $executable in /*) ;; *) fail "executable path must be absolute" ;; esac
    [ -x "$executable" ] || fail "application is not executable: $executable"
    namespace=$(namespace_for "$profile")
    ip netns list | awk '{print $1}' | grep -Fxq "$namespace" ||
        fail "application network profile is not prepared"

    account=$(getent passwd "$user_id" | head -n 1)
    [ -n "$account" ] || fail "desktop user was not found"
    username=$(printf '%s\n' "$account" | cut -d: -f1)
    home=$(printf '%s\n' "$account" | cut -d: -f6)
    cd "$working_dir"
    exec ip netns exec "$namespace" runuser -u "$username" -- env -i \
        "HOME=$home" "USER=$username" "LOGNAME=$username" \
        "PATH=/usr/local/bin:/usr/bin:/bin" "LANG=C.UTF-8" \
        "$executable" "$@"
}

dhcp_hook() {
    action=${1:-}
    profile=${ASTRILL_LAZY_PROFILE:-}
    valid_profile "$profile" || fail "invalid DHCP profile"
    [ "${interface:-}" = eth0 ] || fail "unexpected DHCP interface"
    namespace=$(namespace_for "$profile")
    state_file=$(state_file_for "$profile")

    case $action in
        deconfig)
            ip address flush dev eth0
            rm -f "$state_file"
            ;;
        bound|renew)
            valid_ipv4 "${ip:-}" || fail "DHCP returned an invalid address"
            prefix=$(mask_prefix "${subnet:-255.255.255.0}") || fail "unsupported DHCP subnet mask"
            ip address replace "$ip/$prefix" dev eth0
            old_ifs=$IFS
            IFS=' '
            set -f
            # shellcheck disable=SC2086
            set -- ${router:-}
            set +f
            IFS=$old_ifs
            [ "$#" -eq 0 ] || ip route replace default via "$1" dev eth0
            write_profile_resolver "$namespace" "${dns:-}"
            printf '%s\n' "$ip" > "$state_file"
            chmod 644 "$state_file"
            ;;
    esac
}

prepare_profile() {
    profile=${1:-}
    parent=${2:-}
    valid_profile "$profile" || fail "profile must contain at most 10 lowercase letters or digits"
    valid_interface "$parent" || fail "invalid parent interface"
    [ -x "$BUSYBOX" ] || fail "BusyBox is required for DHCP"
    ip link show "$parent" >/dev/null 2>&1 || fail "parent interface does not exist: $parent"

    mkdir -p "$STATE_DIR"
    chmod 755 "$STATE_DIR"
    namespace=$(namespace_for "$profile")
    state_file=$(state_file_for "$profile")
    pid_file=$(pid_file_for "$profile")
    mac=$(profile_mac "$profile")
    if ip netns list | awk '{print $1}' | grep -Fxq "$namespace" && [ -f "$state_file" ]; then
        address=$(cat "$state_file")
        current_mac=$(
            ip -n "$namespace" link show eth0 2>/dev/null |
                awk '/link\/ether/ { print $2; exit }'
        )
        pid=$(dhcp_pid_for "$pid_file" 2>/dev/null || printf 0)
        if valid_ipv4 "$address" && [ "$current_mac" = "$mac" ] &&
            [ "$pid" -gt 1 ]; then
            if [ -n "${ASTRILL_LAZY_PROFILE_DNS:-}" ]; then
                write_profile_resolver "$namespace" ""
            fi
            printf '{"profile":"%s","namespace":"%s","address":"%s","mac":"%s"}\n' \
                "$profile" "$namespace" "$address" "$mac"
            return 0
        fi
    fi

    cleanup_profile "$profile"
    host_link="al$profile"
    prepare_cleanup=1
    trap '[ "$prepare_cleanup" -eq 0 ] || cleanup_profile "$profile"' EXIT INT TERM
    ip netns add "$namespace"
    mkdir -p "/etc/netns/$namespace"
    ip link add link "$parent" name "$host_link" type macvlan mode bridge
    ip link set "$host_link" address "$mac"
    ip link set "$host_link" netns "$namespace"
    ip -n "$namespace" link set lo up
    ip -n "$namespace" link set "$host_link" name eth0
    ip -n "$namespace" link set eth0 up

    ip netns exec "$namespace" env ASTRILL_LAZY_PROFILE="$profile" \
        "$BUSYBOX" udhcpc -f -i eth0 -p "$pid_file" -s "$0" \
        -x "hostname:astrill-$profile" > "$STATE_DIR/$profile.udhcpc.log" 2>&1 &

    attempts=0
    while [ "$attempts" -lt 20 ]; do
        if [ -f "$state_file" ]; then
            address=$(cat "$state_file")
            if valid_ipv4 "$address"; then
                prepare_cleanup=0
                trap - EXIT INT TERM
                printf '{"profile":"%s","namespace":"%s","address":"%s","mac":"%s"}\n' \
                    "$profile" "$namespace" "$address" "$mac"
                return 0
            fi
        fi
        attempts=$((attempts + 1))
        sleep 1
    done
    cleanup_profile "$profile"
    prepare_cleanup=0
    fail "DHCP did not allocate an address"
}

read_process_env() {
    process_id=$1
    key=$2
    tr '\000' '\n' < "/proc/$process_id/environ" 2>/dev/null |
        sed -n "s/^$key=//p" |
        head -n 1
}

launch_profile() {
    profile=${1:-}
    user_id=${2:-}
    session_pid=${3:-}
    executable=${4:-}
    shift 4
    valid_profile "$profile" || fail "invalid profile"
    if ! is_uint "$user_id" || [ "$user_id" -lt 1000 ]; then
        fail "invalid desktop user"
    fi
    if ! is_uint "$session_pid" || [ "$session_pid" -le 1 ]; then
        fail "invalid desktop process"
    fi
    case $executable in /*) ;; *) fail "application path must be absolute" ;; esac
    [ -x "$executable" ] || fail "application is not executable: $executable"
    namespace=$(namespace_for "$profile")
    ip netns list | awk '{print $1}' | grep -Fxq "$namespace" || fail "application network profile is not prepared"

    account=$(getent passwd "$user_id" | head -n 1)
    [ -n "$account" ] || fail "desktop user was not found"
    username=$(printf '%s\n' "$account" | cut -d: -f1)
    home=$(printf '%s\n' "$account" | cut -d: -f6)
    runtime=/run/user/$user_id
    display=$(read_process_env "$session_pid" DISPLAY)
    wayland=$(read_process_env "$session_pid" WAYLAND_DISPLAY)
    bus=$(read_process_env "$session_pid" DBUS_SESSION_BUS_ADDRESS)
    language=$(read_process_env "$session_pid" LANG)
    xauthority=$(read_process_env "$session_pid" XAUTHORITY)
    session_type=$(read_process_env "$session_pid" XDG_SESSION_TYPE)

    exec ip netns exec "$namespace" runuser -u "$username" -- env \
        "HOME=$home" "USER=$username" "LOGNAME=$username" \
        "XDG_RUNTIME_DIR=$runtime" "DISPLAY=$display" "WAYLAND_DISPLAY=$wayland" \
        "DBUS_SESSION_BUS_ADDRESS=$bus" "LANG=${language:-C.UTF-8}" \
        "XAUTHORITY=$xauthority" "XDG_SESSION_TYPE=$session_type" \
        "$executable" "$@"
}

command=${1:-}
shift || true
if [ "$command" = identity ]; then
    valid_profile "${1:-}" || fail "invalid profile"
    printf '{"profile":"%s","mac":"%s"}\n' "$1" "$(profile_mac "$1")"
    exit 0
fi
[ "$(id -u)" -eq 0 ] || fail "this helper must run through pkexec"
case $command in
    prepare) prepare_profile "$@" ;;
    launch) launch_profile "$@" ;;
    pin-hosts) pin_profile_hosts "$@" ;;
    restrict) restrict_profile "$@" ;;
    execute) execute_profile "$@" ;;
    cleanup)
        valid_profile "${1:-}" || fail "invalid profile"
        cleanup_profile "$1"
        ;;
    dhcp-hook) dhcp_hook "$@" ;;
    deconfig|bound|renew) dhcp_hook "$command" ;;
    *) fail "usage: astrill-lazy-netns identity|prepare|launch|pin-hosts|restrict|execute|cleanup ..." ;;
esac
