#!/bin/sh

cat <<'EOF'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Astrill Lazy Router</title>
  <style>
    :root{color-scheme:light;--ink:#17212b;--muted:#66717d;--line:#d5dbe0;--panel:#fff;--page:#eef1f3;--green:#18794e;--red:#b42318;--blue:#1769aa}
    *{box-sizing:border-box}body{margin:0;background:var(--page);color:var(--ink);font:14px Arial,sans-serif;letter-spacing:0}
    header{background:#202830;color:#fff;border-bottom:3px solid #58a65c}.bar{max-width:1040px;margin:auto;padding:15px 18px;display:flex;align-items:center;gap:18px}
    h1{font-size:19px;margin:0;flex:1}.tabs{display:flex;gap:4px}.tabs a{color:#dce3e8;text-decoration:none;padding:8px 10px;border:1px solid #56616a}
    .tabs a.active{background:#fff;color:#17212b;border-color:#fff}main{max-width:1040px;margin:auto;padding:18px}
    .status{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
    .metric{background:var(--panel);padding:13px}.metric span{display:block;color:var(--muted);font-size:12px;margin-bottom:5px}.metric strong{font-size:16px}
    .section{margin-top:16px;border:1px solid var(--line);background:var(--panel)}.section-head{display:flex;align-items:center;gap:10px;padding:12px;border-bottom:1px solid var(--line)}
    h2{font-size:15px;margin:0;flex:1}.actions{display:flex;gap:6px}button{border:1px solid #aeb7bf;background:#f7f8f9;color:var(--ink);padding:7px 10px;cursor:pointer;font-weight:600}
    button:hover{background:#e9edf0}button:disabled{opacity:.5;cursor:default}.primary{background:var(--blue);border-color:var(--blue);color:#fff}
    .notice{display:none;margin-top:14px;padding:10px 12px;border-left:4px solid #d29a00;background:#fff8df}.notice.show{display:block}
    table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px 12px;border-bottom:1px solid #e5e8eb;vertical-align:middle}th{font-size:12px;color:var(--muted);background:#f8f9fa}
    tr:last-child td{border-bottom:0}.rule-name{font-weight:600}.rule-meta{color:var(--muted);font-size:12px;margin-top:3px}.route{display:inline-flex;border:1px solid #aeb7bf}
    .route button{border:0;border-right:1px solid #aeb7bf;padding:5px 8px}.route button:last-child{border-right:0}.route button.on{background:#dfeae2;color:#145c3d}
    .switch{width:38px;height:21px;border:0;border-radius:11px;padding:2px;background:#aeb7bf}.switch:after{content:"";display:block;width:17px;height:17px;border-radius:50%;background:#fff}
    .switch.on{background:var(--green)}.switch.on:after{margin-left:17px}.good{color:var(--green)}.bad{color:var(--red)}
    .empty{padding:28px;text-align:center;color:var(--muted)}footer{color:var(--muted);font-size:12px;padding:16px 0}
    @media(max-width:720px){.bar{align-items:flex-start;flex-wrap:wrap}.tabs{width:100%}.status{grid-template-columns:repeat(2,minmax(0,1fr))}.section-head{align-items:flex-start;flex-wrap:wrap}.actions{width:100%}th:nth-child(2),td:nth-child(2){display:none}main{padding:10px}th,td{padding:9px 7px}}
  </style>
</head>
<body>
  <header><div class="bar"><h1>Astrill Lazy Router</h1><nav class="tabs"><a href="/MyPage.asp?1">Astrill</a><a class="active" href="/MyPage.asp?3">Policy</a></nav></div></header>
  <main>
    <div id="notice" class="notice"></div>
    <section class="status" aria-label="Policy status">
      <div class="metric"><span>Controller</span><strong id="health">Loading</strong></div>
      <div class="metric"><span>Astrill tunnel</span><strong id="vpn">Loading</strong></div>
      <div class="metric"><span>Policy groups</span><strong id="origins">0</strong></div>
      <div class="metric"><span>Resolved addresses</span><strong id="resolved">0</strong></div>
    </section>
    <section class="section">
      <div class="section-head"><h2>Traffic policy</h2><div class="actions"><button id="refresh">Refresh routes</button><button id="rollback">Rollback</button></div></div>
      <div id="rules"><div class="empty">Loading policy...</div></div>
    </section>
    <footer>Direct rules use the WAN gateway. VPN rules use the current Astrill location and fail closed while the tunnel is down.</footer>
  </main>
  <script>
    const state={busy:false};
    const byId=id=>document.getElementById(id);
    const cleanId=value=>/^[A-Za-z0-9._-]{1,64}$/.test(value)?value:null;
    const decodeLabel=value=>{try{return decodeURIComponent(value)}catch(_){return value}};
    async function load(){
      try{
        const response=await fetch('/MyPage.asp?4&_=' + Date.now(),{cache:'no-store'});
        if(!response.ok)throw new Error('HTTP '+response.status);
        render(await response.json());
      }catch(error){
        byId('health').textContent='Unavailable';byId('health').className='bad';
        showNotice('Could not read the policy controller: '+error.message);
      }
    }
    function render(data){
      byId('health').textContent=data.health==='healthy'?'Healthy':'Needs attention';
      byId('health').className=data.health==='healthy'?'good':'bad';
      byId('vpn').textContent=data.vpn_state==='up'?'Connected':'Disconnected';
      byId('vpn').className=data.vpn_state==='up'?'good':'bad';
      byId('origins').textContent=String(data.origin_count);
      byId('resolved').textContent=String(data.resolved_addresses);
      if(data.vpn_rules>0&&data.vpn_state!=='up')showNotice('VPN policy is fail-closed until Astrill reconnects.');
      else if(data.unresolved_domains>0)showNotice(data.unresolved_domains+' domain(s) could not be resolved; previous addresses are retained when available.');
      else hideNotice();
      const groups=new Map();
      for(const rule of data.rules||[]){
        let group=groups.get(rule.origin);
        if(!group){group={id:rule.origin,label:decodeLabel(rule.label),enabled:false,target:rule.target,count:0,kind:rule.kind};groups.set(rule.origin,group)}
        group.enabled=group.enabled||rule.enabled;group.count++;group.target=rule.target;
      }
      if(!groups.size){byId('rules').innerHTML='<div class="empty">No policies are installed. Add rules from the Ubuntu app.</div>';return}
      const table=document.createElement('table');
      table.innerHTML='<thead><tr><th>Policy</th><th>Compiled matches</th><th>Route</th><th>Enabled</th></tr></thead>';
      const body=document.createElement('tbody');
      for(const group of groups.values()){
        const row=document.createElement('tr');
        const name=document.createElement('td');name.innerHTML='<div class="rule-name"></div><div class="rule-meta"></div>';
        name.firstChild.textContent=group.label;name.lastChild.textContent=group.id;
        const matches=document.createElement('td');matches.textContent=group.count+' '+(group.count===1?'match':'matches');
        const route=document.createElement('td');const routeBox=document.createElement('span');routeBox.className='route';
        for(const target of ['direct','vpn']){const b=document.createElement('button');b.textContent=target==='direct'?'Direct':'Astrill';b.className=group.target===target?'on':'';b.onclick=()=>run('route-origin '+group.id+' '+target);routeBox.appendChild(b)}route.appendChild(routeBox);
        const enabled=document.createElement('td');const toggle=document.createElement('button');toggle.className='switch'+(group.enabled?' on':'');toggle.title=group.enabled?'Disable policy':'Enable policy';toggle.onclick=()=>run('toggle-origin '+group.id);enabled.appendChild(toggle);
        row.append(name,matches,route,enabled);body.appendChild(row);
      }
      table.appendChild(body);byId('rules').replaceChildren(table);
    }
    function showNotice(message){byId('notice').textContent=message;byId('notice').className='notice show'}
    function hideNotice(){byId('notice').className='notice';byId('notice').textContent=''}
    async function run(command){
      if(state.busy)return;
      const parts=command.split(' ');if(!['refresh','rollback','toggle-origin','route-origin'].includes(parts[0]))return;
      if(parts.length>1&&!cleanId(parts[1]))return;
      if(parts.length>2&&!['direct','vpn'].includes(parts[2]))return;
      state.busy=true;document.querySelectorAll('button').forEach(button=>button.disabled=true);
      showNotice('Applying policy change...');
      const form=new URLSearchParams({
        submit_button:'MyPage',action:'ApplyTake',submit_type:'start',change_action:'gozila_cgi',
        ping_ip:'/tmp/astrill-lazy/alctl '+command+' >/tmp/astrill-lazy/web-command.log 2>&1;nvram set ping_ip='
      });
      try{
        const response=await fetch('/apply.cgi',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:form.toString()});
        if(!response.ok)throw new Error('HTTP '+response.status);
        await new Promise(resolve=>setTimeout(resolve,1800));
        await load();
      }catch(error){showNotice('Policy change failed: '+error.message)}
      finally{state.busy=false;document.querySelectorAll('button').forEach(button=>button.disabled=false)}
    }
    byId('refresh').onclick=()=>run('refresh');
    byId('rollback').onclick=()=>run('rollback');
    load();setInterval(load,10000);
  </script>
</body>
</html>
EOF
