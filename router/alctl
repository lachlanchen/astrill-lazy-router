#!/bin/sh

set -u

BASE=${ASTRILL_LAZY_BASE:-/tmp/astrill-lazy}
CURRENT=$BASE/rules.tsv
PREVIOUS=$BASE/rules.previous.tsv
EFFECTIVE=$BASE/effective.tsv
EFFECTIVE_PREVIOUS=$BASE/effective.previous.tsv
OVERLAY_DIR=$BASE/overlays
RUNTIME_EPOCH_FILE=$BASE/runtime-epoch
CORE_GENERATION_FILE=$BASE/core-generation
CORE_RECOVERY_FILE=$BASE/core-recovery
HYBRID_HELPER=${ASTRILL_LAZY_HYBRID_HELPER:-$BASE/alhybrid}
RESOLVED=$BASE/resolved.tsv
UNRESOLVED=$BASE/unresolved.txt
ACTIVE_FILE=$BASE/active-chain
POLICY_TRANSACTION_FILE=$BASE/policy-transaction
APP_FLOWS=$BASE/app-flows.tsv
WATCHDOG_PID=$BASE/watchdog.pid
LOCK_DIR=$BASE/controller.lock
LOG_FILE=$BASE/controller.log
VERSION_FILE=$BASE/VERSION
PACKAGE_MD5_FILE=$BASE/PACKAGE_MD5
RPDB_PREFS_FILE=$BASE/rpdb-prefs
REBASE_REQUIRED_FILE=$BASE/rpdb-rebase-required
RECONCILE_ERROR_FILE=$BASE/last-reconcile-error
LEASES_FILE=${ASTRILL_LAZY_LEASES_FILE:-/tmp/dnsmasq.leases}
ARP_FILE=${ASTRILL_LAZY_ARP_FILE:-/proc/net/arp}

CHAIN_A=AL_LAZY_A
CHAIN_B=AL_LAZY_B
VPN_FAIL_CHAIN=AL_LAZY_VPN_FAIL
APP_CHAIN=AL_LAZY_APP
DIRECT_MARK=0x4000000
VPN_MARK=0x8000000
MARK_MASK=0xc000000
DIRECT_TABLE=213
VPN_TABLE=212
VPN_BLACKHOLE_METRIC=32767
RPDB_PREF_FLOOR=100
REBASE_ERROR_MESSAGE='Astrill restarted outside companion control; run a managed reconnect to rebase policy routing'
ASTRILL_NATIVE_STABLE_ATTEMPTS=12
ASTRILL_NATIVE_STABLE_SAMPLES=2
WATCHDOG_INTERVAL=60
WATCHDOG_REFRESH_CYCLES=30
ASTRILL_CONNECT_ATTEMPTS=60
MAX_RULE_BYTES=6144
MAX_APP_FLOW_BYTES=1024
MAX_APP_FLOWS=16
MIN_NVRAM_FREE_BYTES=2048
PERSIST_PREVIOUS=1
CURRENT_RULES_KEY=astrill_lazy_rules
PREVIOUS_RULES_KEY=astrill_lazy_rules_previous
CURRENT_RULES_GZ_KEY=astrill_lazy_rules_gz
PREVIOUS_RULES_GZ_KEY=astrill_lazy_rules_previous_gz
TAB="$(printf '\t')"
policy_routes_changed=false
hybrid_loaded=false

mkdir -p "$BASE" "$OVERLAY_DIR"

load_hybrid_helper() {
    [ "$hybrid_loaded" = true ] && return 0
    [ -r "$HYBRID_HELPER" ] || return 1
    . "$HYBRID_HELPER" || return 1
    hybrid_loaded=true
}

log_message() {
    level=$1
    shift
    message=$*
    printf '%s [%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$level" "$message" >> "$LOG_FILE"
    if [ "$(wc -l < "$LOG_FILE" 2>/dev/null || printf 0)" -gt 250 ]; then
        tail -n 200 "$LOG_FILE" > "$LOG_FILE.trim"
        mv "$LOG_FILE.trim" "$LOG_FILE"
    fi
    logger -t astrill-lazy "[$level] $message" 2>/dev/null || true
}

fail() {
    log_message ERROR "$*"
    printf 'astrill-lazy: %s\n' "$*" >&2
    exit 1
}

is_uint() {
    case ${1:-} in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_live_pid() {
    pid_value=${1:-}
    is_uint "$pid_value" || return 1
    [ "$pid_value" -gt 1 ] || return 1
    kill -0 "$pid_value" 2>/dev/null
}

valid_id() {
    value=${1:-}
    [ "${#value}" -le 64 ] || return 1
    [ -n "$value" ] || return 1
    case $value in
        *[!A-Za-z0-9._-]*) return 1 ;;
    esac
    return 0
}

valid_domain() {
    value=${1:-}
    [ -n "$value" ] && [ "${#value}" -le 253 ] || return 1
    case $value in
        .*|*.|*..*|*[!A-Za-z0-9.-]*) return 1 ;;
    esac
    printf '%s\n' "$value" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z0-9-]+$'
}

valid_ipv4_network() {
    value=${1:-}
    address=${value%/*}
    if [ "$address" = "$value" ]; then
        prefix=32
    else
        prefix=${value##*/}
    fi
    is_uint "$prefix" && [ "$prefix" -le 32 ] || return 1
    printf '%s\n' "$address" | awk -F. '
        NF != 4 { exit 1 }
        {
            for (i = 1; i <= 4; i++) {
                if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1
            }
        }
    '
}

valid_ipv4_host() {
    case ${1:-} in
        */*) return 1 ;;
    esac
    valid_ipv4_network "$1"
}

valid_mac() {
    printf '%s\n' "${1:-}" | grep -Eq \
        '^[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}$'
}

valid_ports() {
    value=${1:-}
    [ "$value" = "-" ] && return 0
    old_ifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $value
    set +f
    IFS=$old_ifs
    [ "$#" -le 15 ] || return 1
    for entry in "$@"; do
        first=${entry%%:*}
        if [ "$first" = "$entry" ]; then
            last=$first
        else
            last=${entry##*:}
            [ "${entry#*:}" = "$last" ] || return 1
        fi
        is_uint "$first" && is_uint "$last" || return 1
        [ "$first" -ge 1 ] && [ "$first" -le 65535 ] || return 1
        [ "$last" -ge 1 ] && [ "$last" -le 65535 ] || return 1
        [ "$first" -le "$last" ] || return 1
    done
}

validate_rules() {
    file=$1
    bytes=$(wc -c < "$file" 2>/dev/null || printf 0)
    [ "$bytes" -le "$MAX_RULE_BYTES" ] || {
        printf 'rule document exceeds %s bytes\n' "$MAX_RULE_BYTES" >&2
        return 1
    }
    first_line=$(sed -n '1p' "$file")
    [ "$first_line" = "# astrill-lazy-rules-v1" ] || {
        printf 'unsupported or missing rule document header\n' >&2
        return 1
    }
    awk -F '\t' 'NR > 1 && $0 !~ /^#/ && NF != 10 { exit 1 }' "$file" || {
        printf 'every rule must contain exactly 10 tab-separated fields\n' >&2
        return 1
    }
    line_number=0
    while IFS="$TAB" read -r id enabled priority kind selector target protocol ports label origin; do
        line_number=$((line_number + 1))
        case $id in
            ''|\#*) continue ;;
        esac
        valid_id "$id" || {
            printf 'line %s has an invalid rule id\n' "$line_number" >&2
            return 1
        }
        valid_id "$origin" || {
            printf 'line %s has an invalid origin id\n' "$line_number" >&2
            return 1
        }
        case $enabled in 0|1) ;; *) return 1 ;; esac
        is_uint "$priority" && [ "$priority" -le 9999 ] || return 1
        case $kind in
            domain) valid_domain "$selector" || return 1 ;;
            cidr|device) valid_ipv4_network "$selector" || return 1 ;;
            *) return 1 ;;
        esac
        case $target in direct|vpn) ;; *) return 1 ;; esac
        case $protocol in any|tcp|udp) ;; *) return 1 ;; esac
        valid_ports "$ports" || return 1
        [ "$ports" = "-" ] || [ "$protocol" != "any" ] || return 1
        [ -n "$label" ] && [ "${#label}" -le 360 ] || return 1
        case $label in *[!A-Za-z0-9%._~-]*) return 1 ;; esac
    done < "$file"
    return 0
}

rule_row_count() {
    awk -F '\t' '
        $0 !~ /^#/ && NF == 10 { count++ }
        END { print count + 0 }
    ' "$1"
}

document_hash() {
    document_md5=$(md5sum "$1" 2>/dev/null | awk '{ print $1 }')
    [ -n "$document_md5" ] || return 1
    printf 'md5:%s\n' "$document_md5"
}

validate_app_flows() {
    file=$1
    bytes=$(wc -c < "$file" 2>/dev/null || printf 0)
    [ "$bytes" -le "$MAX_APP_FLOW_BYTES" ] || {
        printf 'application flow document exceeds %s bytes\n' \
            "$MAX_APP_FLOW_BYTES" >&2
        return 1
    }
    awk -F '\t' -v maximum="$MAX_APP_FLOWS" '
        NF != 5 { exit 1 }
        { count++ }
        END { exit count > maximum }
    ' "$file" || {
        printf 'application flows require five fields and at most %s rows\n' \
            "$MAX_APP_FLOWS" >&2
        return 1
    }

    while IFS="$TAB" read -r id source protocol ports target; do
        valid_id "$id" || return 1
        valid_ipv4_host "$source" || return 1
        case $protocol in tcp|udp) ;; *) return 1 ;; esac
        valid_ports "$ports" && [ "$ports" != "-" ] || return 1
        case $target in direct|vpn) ;; *) return 1 ;; esac
    done < "$file"
}

acquire_lock() {
    attempts=0
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || printf 0)
        if ! is_live_pid "$lock_pid"; then
            sleep 1
            lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || printf 0)
        fi
        if ! is_live_pid "$lock_pid"; then
            rm -f "$LOCK_DIR/pid"
            rmdir "$LOCK_DIR" 2>/dev/null || true
            continue
        fi
        attempts=$((attempts + 1))
        [ "$attempts" -lt 20 ] || fail "controller is busy (pid $lock_pid)"
        sleep 1
    done
    printf '%s\n' "$$" > "$LOCK_DIR/pid" || {
        rm -f "$LOCK_DIR/pid"
        rmdir "$LOCK_DIR" 2>/dev/null || true
        fail "could not publish controller lock ownership"
    }
    trap controller_exit_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

release_lock() {
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
    trap - EXIT HUP INT TERM
}

cleanup_hybrid_runtime() {
    cleanup_hybrid_error=$1
    if command -v hybrid_cancel_dns_jobs >/dev/null 2>&1; then
        hybrid_cancel_dns_jobs
    fi
    if command -v restore_runtime_metadata >/dev/null 2>&1 &&
       [ "${runtime_metadata_snapshot_active:-false}" = true ] &&
       ! restore_runtime_metadata; then
        set_reconcile_error "$cleanup_hybrid_error"
        return 1
    fi
    if command -v clear_runtime_metadata_snapshot >/dev/null 2>&1; then
        clear_runtime_metadata_snapshot >/dev/null 2>&1 || true
    fi
}

controller_exit_cleanup() {
    controller_exit_status=$?
    trap - EXIT HUP INT TERM
    if ! cleanup_hybrid_runtime \
        "interrupted runtime metadata could not be restored"; then
        [ "$controller_exit_status" -ne 0 ] || controller_exit_status=1
    fi
    if [ -f "$POLICY_TRANSACTION_FILE" ]; then
        if ! load_hybrid_helper ||
           ! hybrid_recover_interrupted_transaction; then
            set_reconcile_error \
                "interrupted policy transaction could not be rolled back"
            [ "$controller_exit_status" -ne 0 ] ||
                controller_exit_status=1
            release_lock
            exit "$controller_exit_status"
        fi
    fi
    rm -f "$BASE/"*".$$"* "$OVERLAY_DIR/"*".$$"*
    release_lock
    exit "$controller_exit_status"
}

require_package_identity() {
    expected_version=$1
    expected_md5=$(printf '%s' "$2" | tr 'A-F' 'a-f')
    case $expected_md5 in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    [ "${#expected_md5}" -eq 32 ] &&
        [ "$(cat "$VERSION_FILE" 2>/dev/null)" = "$expected_version" ] &&
        [ "$(cat "$PACKAGE_MD5_FILE" 2>/dev/null)" = "$expected_md5" ] &&
        [ "$(nvram get astrill_lazy_installed)" = 1 ] &&
        [ "$(nvram get astrill_lazy_version)" = "$expected_version" ] &&
        [ "$(nvram get astrill_lazy_pkg_md5 | tr 'A-F' 'a-f')" = \
            "$expected_md5" ] || {
        printf 'runtime package identity does not match installed NVRAM\n' >&2
        return 1
    }
}

require_hybrid_helper_identity() {
    expected_helper_md5=$(printf '%s' "$1" | tr 'A-F' 'a-f')
    case $expected_helper_md5 in
        *[!0-9a-f]*|'') return 1 ;;
    esac
    [ "${#expected_helper_md5}" -eq 32 ] &&
        [ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" = "$$" ] &&
        [ -r "$HYBRID_HELPER" ] || return 1
    actual_helper_md5=$(md5sum "$HYBRID_HELPER" | awk '{print $1}') ||
        return 1
    [ "$actual_helper_md5" = "$expected_helper_md5" ] || {
        printf 'RAM transaction helper identity does not match\n' >&2
        return 1
    }
}

decode_rule_document() {
    encoded_value=$1
    destination=$2
    archive_file=$BASE/rules.decode.$$.gz
    candidate_file=$BASE/rules.decode.$$.tsv
    {
        printf 'begin-base64 600 rules.tsv.gz\n'
        printf '%s\n' "$encoded_value"
        printf '====\n'
    } | uudecode -o "$archive_file" || {
        rm -f "$archive_file" "$candidate_file"
        return 1
    }
    gunzip -c "$archive_file" > "$candidate_file" || {
        rm -f "$archive_file" "$candidate_file"
        return 1
    }
    rm -f "$archive_file"
    validate_rules "$candidate_file" || {
        rm -f "$candidate_file"
        return 1
    }
    mv "$candidate_file" "$destination"
}

restore_rule_document() {
    destination=$1
    compressed_key=$2
    plain_key=$3
    compressed_value=$(nvram get "$compressed_key")
    if [ -n "$compressed_value" ]; then
        if decode_rule_document "$compressed_value" "$destination"; then
            return 0
        fi
        log_message WARN "stored compressed rule document $compressed_key is invalid"
    fi
    plain_value=$(nvram get "$plain_key")
    [ -n "$plain_value" ] || return 1
    printf '%s\n' "$plain_value" > "$destination"
    validate_rules "$destination" || {
        rm -f "$destination"
        return 1
    }
}

ensure_runtime_epoch() {
    [ -s "$RUNTIME_EPOCH_FILE" ] && return 0
    {
        cat /proc/sys/kernel/random/uuid 2>/dev/null ||
            printf '%s-%s\n' "$(date +%s)" "$$"
    } | md5sum | awk '{ print $1 }' > "$RUNTIME_EPOCH_FILE.new" ||
        return 1
    mv "$RUNTIME_EPOCH_FILE.new" "$RUNTIME_EPOCH_FILE"
}

initialize_rules() {
    ensure_runtime_epoch || return 1
    [ -s "$CORE_GENERATION_FILE" ] || printf '1\n' > "$CORE_GENERATION_FILE"
    if [ -f "$CURRENT" ]; then
        validate_rules "$CURRENT" && return 0
        rm -f "$CURRENT"
    fi
    current_record_present=false
    if [ -n "$(nvram get "$CURRENT_RULES_GZ_KEY")" ] ||
       [ -n "$(nvram get "$CURRENT_RULES_KEY")" ]; then
        current_record_present=true
    fi
    previous_record_present=false
    if [ -n "$(nvram get "$PREVIOUS_RULES_GZ_KEY")" ] ||
       [ -n "$(nvram get "$PREVIOUS_RULES_KEY")" ]; then
        previous_record_present=true
    fi
    if restore_rule_document \
        "$CURRENT" "$CURRENT_RULES_GZ_KEY" "$CURRENT_RULES_KEY"; then
        rm -f "$CORE_RECOVERY_FILE"
    elif [ "$current_record_present" = true ] ||
         [ "$previous_record_present" = true ]; then
        if restore_rule_document \
            "$CURRENT.recovered" \
            "$PREVIOUS_RULES_GZ_KEY" "$PREVIOUS_RULES_KEY"; then
            mv "$CURRENT.recovered" "$CURRENT" || return 1
            printf '%s\n' \
                "persistent current core was invalid; running verified previous core" \
                > "$CORE_RECOVERY_FILE"
            log_message ERROR \
                "persistent current core was invalid; recovered verified previous core"
        else
            rm -f "$CURRENT.recovered"
            printf '# astrill-lazy-rules-v1\n' > "$CURRENT" || return 1
            printf '%s\n' \
                "persistent core was invalid and no verified recovery core was available" \
                > "$CORE_RECOVERY_FILE"
            log_message ERROR \
                "persistent core was invalid; quarantined to an empty degraded runtime"
        fi
    else
        printf '# astrill-lazy-rules-v1\n' > "$CURRENT" || return 1
        rm -f "$CORE_RECOVERY_FILE"
    fi
    restore_rule_document \
        "$PREVIOUS" "$PREVIOUS_RULES_GZ_KEY" "$PREVIOUS_RULES_KEY" ||
        rm -f "$PREVIOUS"
}

validate_persisted_core() {
    pc_base=$BASE/validate.$$
    rm -rf "$pc_base"
    mkdir -p "$pc_base"
    ASTRILL_LAZY_BASE=$pc_base "$0" rules > "$pc_base/selected.tsv"
    pc_ok=$?
    pc_recovery=$(cat "$pc_base/core-recovery" 2>/dev/null || true)
    pc_selected=current
    if [ -n "$pc_recovery" ]; then
        pc_ok=1
        case $pc_recovery in
            *previous*) pc_selected=previous ;;
            *) pc_selected=quarantine-empty ;;
        esac
    elif [ -z "$(nvram get "$CURRENT_RULES_GZ_KEY")$(nvram get "$CURRENT_RULES_KEY")" ]; then
        pc_selected=empty
    fi
    pc_hash=$(document_hash "$pc_base/selected.tsv" 2>/dev/null || true)
    pc_rows=$(rule_row_count "$pc_base/selected.tsv")
    if [ "$1" = true ]; then
        [ "$pc_ok" -eq 0 ] && pc_ok_json=true || pc_ok_json=false
        printf '{"ok":%s,"selected":"%s","hash":"%s","rows":%s}\n' \
            "$pc_ok_json" "$pc_selected" "$pc_hash" "$pc_rows"
    else
        printf 'selected=%s hash=%s rows=%s\n' \
            "$pc_selected" "$pc_hash" "$pc_rows"
    fi
    rm -rf "$pc_base"
    [ "$pc_ok" -eq 0 ]
}

initialize_app_flows() {
    [ -f "$APP_FLOWS" ] || : > "$APP_FLOWS"
}

chain_exists() {
    iptables -w 10 -t mangle -S "$1" >/dev/null 2>&1
}

ensure_chain_shell() {
    chain=$1
    chain_exists "$chain" || iptables -w 10 -t mangle -N "$chain"
    iptables -w 10 -t mangle -F "$chain"
    iptables -w 10 -t mangle -A "$chain" -d 10.0.0.0/8 -j RETURN
    iptables -w 10 -t mangle -A "$chain" -d 172.16.0.0/12 -j RETURN
    iptables -w 10 -t mangle -A "$chain" -d 192.168.0.0/16 -j RETURN
    iptables -w 10 -t mangle -A "$chain" -d 224.0.0.0/4 -j RETURN
    iptables -w 10 -t mangle -A "$chain" -d 255.255.255.255/32 -j RETURN
}

resolve_domain() {
    domain=$1
    dns_server=$(nvram get lan_ipaddr)
    nslookup "$domain" "$dns_server" 2>/dev/null | awk '
        /^Name:/ { seen = 1; next }
        seen && /^Address [0-9]+:/ {
            if ($3 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $3
        }
    ' | sort -u | head -n 16
}

domain_addresses() {
    domain=$1
    cache_file=$2
    refresh_mode=${3:-0}
    addresses=$(awk -F '\t' -v domain="$domain" '$1 == domain { print $2 }' "$cache_file" 2>/dev/null)
    if [ -n "$addresses" ]; then
        printf '%s\n' "$addresses"
        return 0
    fi
    if [ -z "$addresses" ] && [ "$refresh_mode" != 1 ]; then
        addresses=$(awk -F '\t' -v domain="$domain" '$1 == domain { print $2 }' "$RESOLVED" 2>/dev/null)
    fi
    if [ -z "$addresses" ]; then
        addresses=$(resolve_domain "$domain")
        if [ -z "$addresses" ]; then
            addresses=$(awk -F '\t' -v domain="$domain" '$1 == domain { print $2 }' "$RESOLVED" 2>/dev/null)
        fi
    fi
    if [ -n "$addresses" ]; then
        now=$(date +%s)
        for address in $addresses; do
            printf '%s\t%s\t%s\n' "$domain" "$address" "$now" >> "$cache_file"
        done
    fi
    printf '%s\n' "$addresses"
}

append_rule_pair() {
    chain=$1
    kind=$2
    selector=$3
    target=$4
    protocol=$5
    port=$6

    if [ "$target" = "direct" ]; then
        mark=$DIRECT_MARK
    else
        mark=$VPN_MARK
    fi

    set -- iptables -w 10 -t mangle -A "$chain"
    case $kind in
        destination) set -- "$@" -d "$selector" ;;
        source) set -- "$@" -s "$selector" ;;
        *) return 1 ;;
    esac
    if [ "$protocol" != "any" ]; then
        set -- "$@" -p "$protocol"
    fi
    if [ "$port" != "-" ]; then
        set -- "$@" --dport "$port"
    fi
    "$@" -j MARK --set-xmark "$mark/$MARK_MASK" || return 1
    "$@" -j RETURN || return 1
}

append_compiled_rule() {
    chain=$1
    kind=$2
    selector=$3
    target=$4
    protocol=$5
    ports=$6

    if [ "$ports" = "-" ]; then
        append_rule_pair "$chain" "$kind" "$selector" "$target" "$protocol" "-"
        return
    fi
    old_ifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $ports
    set +f
    IFS=$old_ifs
    for port in "$@"; do
        append_rule_pair "$chain" "$kind" "$selector" "$target" "$protocol" \
            "$port" || return 1
    done
}

append_app_flow_pair() {
    chain=$1
    source=$2
    target=$3
    protocol=$4
    port=$5

    if [ "$target" = direct ]; then
        mark=$DIRECT_MARK
    else
        mark=$VPN_MARK
    fi

    set -- iptables -w 10 -t mangle -A "$chain" \
        -s "$source" -p "$protocol" --sport "$port"
    "$@" -j MARK --set-xmark "$mark/$MARK_MASK" || return 1
    "$@" -j RETURN || return 1
}

append_app_flow() {
    chain=$1
    source=$2
    target=$3
    protocol=$4
    ports=$5
    old_ifs=$IFS
    IFS=,
    set -f
    # shellcheck disable=SC2086
    set -- $ports
    set +f
    IFS=$old_ifs
    for port in "$@"; do
        append_app_flow_pair \
            "$chain" "$source" "$target" "$protocol" "$port" || return 1
    done
}

build_app_chain() {
    file=$1
    ensure_chain_shell "$APP_CHAIN" || return 1
    while IFS="$TAB" read -r _id source protocol ports target; do
        append_app_flow \
            "$APP_CHAIN" "$source" "$target" "$protocol" "$ports" || return 1
    done < "$file"
    iptables -w 10 -t mangle -A "$APP_CHAIN" -j RETURN
}

build_chain() {
    chain=$1
    file=$2
    refresh_mode=${3:-0}
    new_resolved=$BASE/resolved.new.$$.tsv
    new_unresolved=$BASE/unresolved.new.$$.txt
    : > "$new_resolved"
    : > "$new_unresolved"
    ensure_chain_shell "$chain" || return 1

    while IFS="$TAB" read -r id enabled priority kind selector target \
        protocol ports label origin; do
        case $id in ''|\#*) continue ;; esac
        [ "$enabled" = 1 ] || continue
        case $kind in
            domain)
                addresses=$(domain_addresses "$selector" "$new_resolved" "$refresh_mode")
                if [ -z "$addresses" ]; then
                    printf '%s\n' "$selector" >> "$new_unresolved"
                    continue
                fi
                for address in $addresses; do
                    append_compiled_rule "$chain" destination "$address/32" \
                        "$target" "$protocol" "$ports" || return 1
                done
                ;;
            cidr)
                append_compiled_rule "$chain" destination "$selector" \
                    "$target" "$protocol" "$ports" || return 1
                ;;
            device)
                append_compiled_rule "$chain" source "$selector" "$target" \
                    "$protocol" "$ports" || return 1
                ;;
        esac
    done < "$file"
    iptables -w 10 -t mangle -A "$chain" -j RETURN || return 1
    runtime_resolved_candidate=$new_resolved
    runtime_unresolved_candidate=$new_unresolved
}

active_chain() {
    active=$(cat "$ACTIVE_FILE" 2>/dev/null || printf '%s' "$CHAIN_A")
    case $active in "$CHAIN_A"|"$CHAIN_B") ;; *) active=$CHAIN_A ;; esac
    printf '%s\n' "$active"
}

inactive_chain() {
    if [ "$(active_chain)" = "$CHAIN_A" ]; then
        printf '%s\n' "$CHAIN_B"
    else
        printf '%s\n' "$CHAIN_A"
    fi
}

chain_document_hash_file() {
    case $1 in
        "$CHAIN_A") printf '%s/chain-a.document-hash\n' "$BASE" ;;
        "$CHAIN_B") printf '%s/chain-b.document-hash\n' "$BASE" ;;
        *) return 1 ;;
    esac
}

prerouting_rules() {
    iptables -w 10 -t mangle -S PREROUTING 2>/dev/null
}

prerouting_jump_count() {
    jump_count_rules=$(prerouting_rules) || return 1
    printf '%s\n' "$jump_count_rules" |
        awk -v rule="-A PREROUTING -j $1" '$0 == rule { n++ } END { print n+0 }'
}

first_prerouting_rule() {
    prerouting_rules | sed -n '2p'
}

remove_prerouting_jump() {
    chain=$1
    remove_count=$(prerouting_jump_count "$chain") || return 1
    while [ "$remove_count" -gt 0 ]; do
        iptables -w 10 -t mangle -D PREROUTING -j "$chain" || return 1
        remove_next_count=$(prerouting_jump_count "$chain") || return 1
        [ "$remove_next_count" -lt "$remove_count" ] || return 1
        remove_count=$remove_next_count
    done
    [ "$(prerouting_jump_count "$chain")" -eq 0 ]
}

activate_chain() {
    activation_target=$1
    case $activation_target in "$CHAIN_A"|"$CHAIN_B") ;; *) return 1 ;; esac
    activation_other=$CHAIN_A
    [ "$activation_target" = "$CHAIN_A" ] && activation_other=$CHAIN_B

    iptables -w 10 -t mangle -I PREROUTING 1 -j "$activation_target" || return 1
    remove_prerouting_jump "$activation_other" || return 1
    activation_count=$(prerouting_jump_count "$activation_target") || return 1
    while [ "$activation_count" -gt 1 ]; do
        iptables -w 10 -t mangle -D PREROUTING -j "$activation_target" ||
            return 1
        activation_next_count=$(
            prerouting_jump_count "$activation_target"
        ) || return 1
        [ "$activation_next_count" -lt "$activation_count" ] || return 1
        activation_count=$activation_next_count
    done
    if [ "$(first_prerouting_rule)" != \
        "-A PREROUTING -j $activation_target" ]; then
        remove_prerouting_jump "$activation_target" || return 1
        iptables -w 10 -t mangle -I PREROUTING 1 \
            -j "$activation_target" || return 1
    fi
    activation_count=$(prerouting_jump_count "$activation_target") ||
        return 1
    [ "$activation_count" -eq 1 ] || return 1
    [ "$(prerouting_jump_count "$activation_other")" -eq 0 ] || return 1
    [ "$(first_prerouting_rule)" = \
        "-A PREROUTING -j $activation_target" ] || return 1
    activation_target_references=$(
        policy_chain_reference_count "$activation_target"
    ) || return 1
    activation_other_references=$(
        policy_chain_reference_count "$activation_other"
    ) || return 1
    [ "$activation_target_references" -eq 1 ] &&
        [ "$activation_other_references" -eq 0 ] || return 1
    printf '%s\n' "$activation_target" > "$ACTIVE_FILE.new.$$" || return 1
    mv "$ACTIVE_FILE.new.$$" "$ACTIVE_FILE"
}

cleanup_app_chain() {
    app_cleanup_failed=false
    remove_prerouting_jump "$APP_CHAIN"
    iptables -w 10 -t mangle -C PREROUTING -j "$APP_CHAIN" \
        >/dev/null 2>&1 && app_cleanup_failed=true
    if chain_exists "$APP_CHAIN"; then
        iptables -w 10 -t mangle -F "$APP_CHAIN" 2>/dev/null ||
            app_cleanup_failed=true
        iptables -w 10 -t mangle -X "$APP_CHAIN" 2>/dev/null ||
            app_cleanup_failed=true
    fi
    chain_exists "$APP_CHAIN" && app_cleanup_failed=true
    [ "$app_cleanup_failed" = false ]
}

ensure_app_jump() {
    active=$(active_chain)
    first_jump=$(iptables -w 10 -t mangle -S PREROUTING 2>/dev/null | sed -n '2p')
    [ "$first_jump" = "-A PREROUTING -j $active" ] || return 1
    second_jump=$(iptables -w 10 -t mangle -S PREROUTING 2>/dev/null | sed -n '3p')
    if [ "$second_jump" != "-A PREROUTING -j $APP_CHAIN" ]; then
        remove_prerouting_jump "$APP_CHAIN"
        iptables -w 10 -t mangle -I PREROUTING 2 -j "$APP_CHAIN" || return 1
    fi
}

ensure_app_runtime() {
    initialize_app_flows
    validate_app_flows "$APP_FLOWS" || return 1
    if [ ! -s "$APP_FLOWS" ]; then
        cleanup_app_chain
        return 0
    fi
    if ! chain_exists "$APP_CHAIN"; then
        build_app_chain "$APP_FLOWS" || return 1
    fi
    ensure_app_jump
}

apply_app_flow_file() {
    candidate=$1
    validate_app_flows "$candidate" || return 1
    ensure_routes || return 1
    previous=$BASE/app-flows.previous.tsv
    cp "$APP_FLOWS" "$previous" || return 1
    if [ -s "$candidate" ]; then
        if ! build_app_chain "$candidate" || ! ensure_app_jump; then
            if [ -s "$previous" ]; then
                build_app_chain "$previous" >/dev/null 2>&1 || true
                ensure_app_jump >/dev/null 2>&1 || true
            else
                cleanup_app_chain
            fi
            rm -f "$previous"
            return 1
        fi
    else
        cleanup_app_chain
    fi
    if ! cp "$candidate" "$APP_FLOWS"; then
        if [ -s "$previous" ]; then
            build_app_chain "$previous" >/dev/null 2>&1 || true
            ensure_app_jump >/dev/null 2>&1 || true
        else
            cleanup_app_chain
        fi
        rm -f "$previous"
        return 1
    fi
    rm -f "$previous"
}

transform_app_flow() {
    operation=$1
    id=${2:-}
    valid_id "$id" || fail "invalid application flow id"
    initialize_app_flows
    candidate=$BASE/app-flows.candidate.tsv
    awk -F '\t' -v id="$id" '$1 != id' "$APP_FLOWS" > "$candidate"

    case $operation in
        set)
            source=${3:-}
            protocol=${4:-}
            ports=${5:-}
            target=${6:-}
            valid_ipv4_host "$source" || fail "invalid application source address"
            case $protocol in tcp|udp) ;; *) fail "application flow must use tcp or udp" ;; esac
            if ! valid_ports "$ports" || [ "$ports" = "-" ]; then
                fail "invalid application source ports"
            fi
            case $target in direct|vpn) ;; *) fail "route target must be direct or vpn" ;; esac
            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$id" "$source" "$protocol" "$ports" "$target" >> "$candidate"
            ;;
        delete) ;;
        *) fail "unknown application flow operation" ;;
    esac

    apply_app_flow_file "$candidate" ||
        fail "could not activate application flow"
    rm -f "$candidate"
}

ensure_ip_rule() {
    pref=$1
    mark=$2
    table=$3
    existing=$(ip rule show | awk -v pref="$pref:" '$1 == pref { print; exit }')
    if [ -z "$existing" ]; then
        ip rule add pref "$pref" fwmark "$mark/$MARK_MASK" lookup "$table" ||
            return 1
        policy_routes_changed=true
        return
    fi
    printf '%s\n' "$existing" | grep -q "fwmark $mark/$MARK_MASK.*lookup $table" || {
        log_message ERROR "policy preference $pref is occupied: $existing"
        return 1
    }
}

native_min_pref() {
    ip rule show | awk '
        /lookup (110|111|112|113|114)([[:space:]]|$)/ {
            pref = $1
            sub(/:$/, "", pref)
            if (pref ~ /^[0-9]+$/ && (lowest == "" || pref < lowest)) {
                lowest = pref
            }
        }
        END { print lowest }
    '
}

tunnel_is_up() {
    ip link show tun0 >/dev/null 2>&1 &&
        ip route show table main | grep -q ' dev tun0'
}

native_state_signature() {
    ip rule show | awk '
        /lookup (110|111|112|113|114)([[:space:]]|$)/ {
            pref = $1
            sub(/:$/, "", pref)
            table = ""
            for (i = 1; i <= NF; i++) {
                if ($i == "lookup") table = $(i + 1)
            }
            if (pref ~ /^[0-9]+$/ && table != "") {
                printf "%s/%s,", pref, table
            }
        }
        END { print "" }
    '
}

wait_for_native_rules_stable() {
    native_previous=
    native_stable_samples=0
    native_attempt=0
    while [ "$native_attempt" -lt "$ASTRILL_NATIVE_STABLE_ATTEMPTS" ]; do
        tunnel_is_up || return 1
        native_current_min=$(native_min_pref)
        if is_uint "$native_current_min"; then
            native_current=$(native_state_signature)
            if [ -n "$native_previous" ] &&
               [ "$native_current" = "$native_previous" ]; then
                native_stable_samples=$((native_stable_samples + 1))
            else
                native_stable_samples=1
            fi
            if [ "$native_stable_samples" -ge "$ASTRILL_NATIVE_STABLE_SAMPLES" ]; then
                return 0
            fi
            native_previous=$native_current
        else
            native_previous=
            native_stable_samples=0
        fi
        native_attempt=$((native_attempt + 1))
        sleep 1
    done
    return 1
}

rule_prefs_for_signature() {
    signature_mark=$1
    signature_table=$2
    ip rule show | awk -v mark="$signature_mark/$MARK_MASK" \
        -v table="$signature_table" '
        {
            wanted_mark = 0
            wanted_table = 0
            for (i = 1; i <= NF; i++) {
                if ($i == "fwmark" && $(i + 1) == mark) wanted_mark = 1
                if ($i == "lookup" && $(i + 1) == table) wanted_table = 1
            }
            if (wanted_mark && wanted_table) {
                pref = $1
                sub(/:$/, "", pref)
                if (pref ~ /^[0-9]+$/ && !seen[pref]++) print pref
            }
        }
    '
}

ip_rule_matches() {
    match_pref=$1
    match_mark=$2
    match_table=$3
    rule_prefs_for_signature "$match_mark" "$match_table" |
        grep -qx "$match_pref"
}

remove_exact_ip_rule() {
    pref=$1
    mark=$2
    table=$3
    while ip_rule_matches "$pref" "$mark" "$table"; do
        ip rule del pref "$pref" fwmark "$mark/$MARK_MASK" lookup "$table" ||
            return 1
        policy_routes_changed=true
    done
}

remove_owned_ip_rules() {
    for owned_pref in $(rule_prefs_for_signature "$DIRECT_MARK" "$DIRECT_TABLE"); do
        remove_exact_ip_rule "$owned_pref" "$DIRECT_MARK" "$DIRECT_TABLE" ||
            return 1
    done
    for owned_pref in $(rule_prefs_for_signature "$VPN_MARK" "$VPN_TABLE"); do
        remove_exact_ip_rule "$owned_pref" "$VPN_MARK" "$VPN_TABLE" ||
            return 1
    done
    rm -f "$RPDB_PREFS_FILE"
}

owned_rule_count() {
    {
        rule_prefs_for_signature "$DIRECT_MARK" "$DIRECT_TABLE"
        rule_prefs_for_signature "$VPN_MARK" "$VPN_TABLE"
    } | awk 'NF { count++ } END { print count + 0 }'
}

current_owned_pref() {
    current_mark=$1
    current_table=$2
    rule_prefs_for_signature "$current_mark" "$current_table" |
        awk '
            NF {
                count++
                value = $1
            }
            END {
                if (count == 1) print value
            }
        '
}

load_owned_pref_state() {
    owned_direct_pref=
    owned_vpn_pref=
    owned_native_pref=
    [ -f "$RPDB_PREFS_FILE" ] || return 1
    IFS="$TAB" read -r owned_direct_pref owned_vpn_pref owned_native_pref \
        < "$RPDB_PREFS_FILE" || return 1
    is_uint "$owned_direct_pref" &&
        is_uint "$owned_vpn_pref" &&
        is_uint "$owned_native_pref" || return 1
    [ "$owned_direct_pref" -ge "$RPDB_PREF_FLOOR" ] &&
        [ "$owned_direct_pref" -lt "$owned_vpn_pref" ] &&
        [ "$owned_vpn_pref" -lt "$owned_native_pref" ]
}

record_owned_prefs() {
    record_direct_pref=$1
    record_vpn_pref=$2
    record_native_pref=$3
    printf '%s\t%s\t%s\n' \
        "$record_direct_pref" "$record_vpn_pref" "$record_native_pref" \
        > "$RPDB_PREFS_FILE.new" || return 1
    mv "$RPDB_PREFS_FILE.new" "$RPDB_PREFS_FILE"
}

rebase_is_required() {
    [ -f "$REBASE_REQUIRED_FILE" ]
}

clear_rebase_required() {
    [ ! -f "$REBASE_REQUIRED_FILE" ] || rm -f "$REBASE_REQUIRED_FILE"
}

native_undercuts_recorded_overlay() {
    load_owned_pref_state || return 1
    undercut_native_pref=$(native_min_pref)
    is_uint "$undercut_native_pref" || return 1
    [ "$undercut_native_pref" -le "$owned_vpn_pref" ]
}

mark_rebase_required() {
    rebase_native_pref=${1:-unknown}
    rebase_direct_pref=${2:-unknown}
    rebase_vpn_pref=${3:-unknown}
    [ -f "$REBASE_REQUIRED_FILE" ] || {
        printf '%s\t%s\t%s\n' \
            "$rebase_native_pref" "$rebase_direct_pref" "$rebase_vpn_pref" \
            > "$REBASE_REQUIRED_FILE"
    }
}

mark_recorded_overlay_for_rebase() {
    native_undercuts_recorded_overlay || return 1
    mark_rebase_required \
        "$undercut_native_pref" "$owned_direct_pref" "$owned_vpn_pref"
}

preference_is_free() {
    free_pref=$1
    occupied_pref=$(
        ip rule show |
            awk -v pref="$free_pref:" '$1 == pref { print $1; exit }'
    )
    [ -z "$occupied_pref" ]
}

select_owned_prefs() {
    selected_native_pref=$1
    selected_vpn_pref=$((selected_native_pref - 1))
    selected_direct_pref=$((selected_native_pref - 2))
    while [ "$selected_direct_pref" -ge "$RPDB_PREF_FLOOR" ]; do
        if preference_is_free "$selected_direct_pref" &&
           preference_is_free "$selected_vpn_pref"; then
            printf '%s\t%s\n' "$selected_direct_pref" "$selected_vpn_pref"
            return 0
        fi
        selected_vpn_pref=$selected_direct_pref
        selected_direct_pref=$((selected_direct_pref - 1))
    done
    return 1
}

normalize_route_output() {
    awk 'NF { $1 = $1; print }'
}

vpn_gateway_for_tun() {
    ip route show table main | awk '
        $1 == "0.0.0.0/1" && $0 ~ / dev tun0/ { print $3; exit }
    '
}

vpn_fallback_route() {
    printf 'blackhole default metric %s\n' "$VPN_BLACKHOLE_METRIC"
}

direct_table_is_ready() {
    ready_wan_iface=$(nvram get wan_iface)
    ready_wan_gateway=$(nvram get wan_gateway)
    [ -n "$ready_wan_iface" ] && [ -n "$ready_wan_gateway" ] || return 1
    ready_direct_routes=$(
        ip route show table "$DIRECT_TABLE" 2>/dev/null |
            normalize_route_output
    )
    ready_direct_route_count=$(
        printf '%s\n' "$ready_direct_routes" |
            awk 'NF { count++ } END { print count + 0 }'
    )
    [ "$ready_direct_route_count" -eq 1 ] &&
        [ "$ready_direct_routes" = \
            "default via $ready_wan_gateway dev $ready_wan_iface" ]
}

vpn_table_is_ready() {
    ready_vpn_routes=$(
        ip route show table "$VPN_TABLE" 2>/dev/null |
            normalize_route_output
    )
    ready_vpn_route_count=$(
        printf '%s\n' "$ready_vpn_routes" |
            awk 'NF { count++ } END { print count + 0 }'
    )
    ready_vpn_fallback=$(vpn_fallback_route)
    if tunnel_is_up; then
        ready_vpn_gateway=$(vpn_gateway_for_tun)
        [ -n "$ready_vpn_gateway" ] &&
            [ "$ready_vpn_route_count" -eq 2 ] &&
            printf '%s\n' "$ready_vpn_routes" |
                grep -Fxq "default via $ready_vpn_gateway dev tun0" &&
            printf '%s\n' "$ready_vpn_routes" |
                grep -Fxq "$ready_vpn_fallback"
    else
        [ "$ready_vpn_route_count" -eq 1 ] &&
            [ "$ready_vpn_routes" = "$ready_vpn_fallback" ]
    fi
}

native_tables_are_ready() {
    tunnel_is_up || return 1
    ready_native_pref=$(native_min_pref)
    is_uint "$ready_native_pref"
}

filter_chain_exists() {
    iptables -w 10 -t filter -S "$1" >/dev/null 2>&1
}

remove_vpn_fail_closed_jump() {
    while iptables -w 10 -t filter -C FORWARD -j "$VPN_FAIL_CHAIN" \
        >/dev/null 2>&1; do
        iptables -w 10 -t filter -D FORWARD -j "$VPN_FAIL_CHAIN" || return 1
        policy_routes_changed=true
    done
}

vpn_fail_closed_is_ready() {
    filter_chain_exists "$VPN_FAIL_CHAIN" || return 1
    fail_closed_rule_count=$(
        iptables -w 10 -t filter -S "$VPN_FAIL_CHAIN" 2>/dev/null |
            awk -v chain="$VPN_FAIL_CHAIN" '
                $1 == "-A" && $2 == chain { count++ }
                END { print count + 0 }
            '
    )
    [ "$fail_closed_rule_count" -eq 1 ] || return 1
    iptables -w 10 -t filter -C "$VPN_FAIL_CHAIN" \
        -m mark --mark "$VPN_MARK/$MARK_MASK" -j DROP >/dev/null 2>&1 ||
        return 1
    first_forward_rule=$(
        iptables -w 10 -t filter -S FORWARD 2>/dev/null |
            awk '$1 == "-A" && $2 == "FORWARD" { print; exit }'
    )
    [ "$first_forward_rule" = "-A FORWARD -j $VPN_FAIL_CHAIN" ]
}

ensure_vpn_fail_closed() {
    vpn_fail_closed_is_ready && return 0
    filter_chain_exists "$VPN_FAIL_CHAIN" ||
        iptables -w 10 -t filter -N "$VPN_FAIL_CHAIN" || return 1
    iptables -w 10 -t filter -F "$VPN_FAIL_CHAIN" || return 1
    iptables -w 10 -t filter -A "$VPN_FAIL_CHAIN" \
        -m mark --mark "$VPN_MARK/$MARK_MASK" -j DROP || return 1
    remove_vpn_fail_closed_jump || return 1
    iptables -w 10 -t filter -I FORWARD 1 -j "$VPN_FAIL_CHAIN" || return 1
    policy_routes_changed=true
    vpn_fail_closed_is_ready
}

disable_vpn_fail_closed() {
    remove_vpn_fail_closed_jump
}

set_reconcile_error() {
    reconcile_message=$*
    previous_reconcile_message=$(
        cat "$RECONCILE_ERROR_FILE" 2>/dev/null || true
    )
    [ "$previous_reconcile_message" = "$reconcile_message" ] && return 0
    printf '%s\n' "$reconcile_message" > "$RECONCILE_ERROR_FILE"
    log_message ERROR "$reconcile_message"
}

clear_reconcile_error() {
    [ ! -f "$RECONCILE_ERROR_FILE" ] || rm -f "$RECONCILE_ERROR_FILE"
}

flush_policy_route_cache_if_changed() {
    [ "$policy_routes_changed" = true ] || return 0
    ip route flush cache 2>/dev/null || true
    policy_routes_changed=false
}

prepare_for_astrill_start() {
    policy_routes_changed=false
    ensure_vpn_fail_closed || {
        set_reconcile_error "could not enable VPN-policy fail-closed before Astrill start"
        return 1
    }
    remove_owned_ip_rules || {
        set_reconcile_error "could not remove companion policy rules before Astrill start"
        return 1
    }
    clear_rebase_required
    flush_policy_route_cache_if_changed
    return 0
}

prepare_for_astrill_stop() {
    policy_routes_changed=false
    ensure_vpn_fail_closed || {
        set_reconcile_error "could not enable VPN-policy fail-closed before Astrill stop"
        return 1
    }
    flush_policy_route_cache_if_changed
    return 0
}

ensure_policy_tables() {
    wan_iface=$(nvram get wan_iface)
    wan_gateway=$(nvram get wan_gateway)
    if [ -z "$wan_iface" ] || [ -z "$wan_gateway" ]; then
        return 1
    fi

    if ! direct_table_is_ready; then
        policy_routes_changed=true
        ip route flush table "$DIRECT_TABLE"
        ip route add table "$DIRECT_TABLE" default via "$wan_gateway" dev "$wan_iface" ||
            return 1
    fi

    if tunnel_is_up; then
        vpn_gateway=$(vpn_gateway_for_tun)
        [ -n "$vpn_gateway" ] || return 1
        if ! vpn_table_is_ready; then
            policy_routes_changed=true
            ip route flush table "$VPN_TABLE"
            ip route add table "$VPN_TABLE" default via "$vpn_gateway" dev tun0 ||
                return 1
            ip route add blackhole default metric "$VPN_BLACKHOLE_METRIC" \
                table "$VPN_TABLE" || return 1
        fi
    else
        if ! vpn_table_is_ready; then
            policy_routes_changed=true
            ip route flush table "$VPN_TABLE"
            ip route add blackhole default metric "$VPN_BLACKHOLE_METRIC" \
                table "$VPN_TABLE" || return 1
        fi
    fi
    direct_table_is_ready && vpn_table_is_ready
}

owned_overlay_is_valid() {
    tunnel_is_up || return 1
    direct_table_is_ready && vpn_table_is_ready && native_tables_are_ready ||
        return 1
    load_owned_pref_state || return 1
    actual_direct_pref=$(current_owned_pref "$DIRECT_MARK" "$DIRECT_TABLE")
    actual_vpn_pref=$(current_owned_pref "$VPN_MARK" "$VPN_TABLE")
    [ "$actual_direct_pref" = "$owned_direct_pref" ] &&
        [ "$actual_vpn_pref" = "$owned_vpn_pref" ] || return 1
    current_native_pref=$(native_min_pref)
    is_uint "$current_native_pref" &&
        [ "$owned_direct_pref" -lt "$owned_vpn_pref" ] &&
        [ "$owned_vpn_pref" -lt "$current_native_pref" ] || return 1
    ip_rule_matches "$owned_direct_pref" "$DIRECT_MARK" "$DIRECT_TABLE" &&
        ip_rule_matches "$owned_vpn_pref" "$VPN_MARK" "$VPN_TABLE"
}

discard_failed_overlay_install() {
    mark_recorded_overlay_for_rebase >/dev/null 2>&1 || true
    remove_owned_ip_rules >/dev/null 2>&1 || true
    return 1
}

install_owned_overlay() {
    install_native_pref=$(native_min_pref)
    is_uint "$install_native_pref" || return 1
    selected_prefs=$(select_owned_prefs "$install_native_pref") || return 1
    install_direct_pref=${selected_prefs%%"$TAB"*}
    install_vpn_pref=${selected_prefs#*"$TAB"}
    record_owned_prefs \
        "$install_direct_pref" "$install_vpn_pref" "$install_native_pref" ||
        return 1
    ensure_ip_rule "$install_direct_pref" "$DIRECT_MARK" "$DIRECT_TABLE" || {
        discard_failed_overlay_install
        return 1
    }
    ensure_ip_rule "$install_vpn_pref" "$VPN_MARK" "$VPN_TABLE" || {
        discard_failed_overlay_install
        return 1
    }
    if ! owned_overlay_is_valid; then
        discard_failed_overlay_install
        return 1
    fi
    flush_policy_route_cache_if_changed
    return 0
}

degrade_until_managed_rebase() {
    ensure_vpn_fail_closed || {
        set_reconcile_error "could not protect VPN-policy traffic after an unmanaged Astrill restart"
        return 1
    }
    if [ "$(owned_rule_count)" -ne 0 ] || [ -f "$RPDB_PREFS_FILE" ]; then
        remove_owned_ip_rules || {
            set_reconcile_error "could not remove undercut companion policy rules"
            return 1
        }
    fi
    ensure_policy_tables || {
        set_reconcile_error "companion policy tables are not ready after an unmanaged Astrill restart"
        return 1
    }
    set_reconcile_error "$REBASE_ERROR_MESSAGE"
    flush_policy_route_cache_if_changed
    return 1
}

ensure_routes() {
    policy_routes_changed=false
    if ! tunnel_is_up; then
        ensure_vpn_fail_closed || {
            set_reconcile_error "could not enforce VPN-policy fail-closed while Astrill is down"
            return 1
        }
        if [ "$(owned_rule_count)" -ne 0 ] || [ -f "$RPDB_PREFS_FILE" ]; then
            remove_owned_ip_rules || {
                set_reconcile_error "could not remove companion policy rules while Astrill is down"
                return 1
            }
        fi
        clear_rebase_required
        ensure_policy_tables || {
            set_reconcile_error "companion policy tables are not ready while Astrill is down"
            return 1
        }
        clear_reconcile_error
        flush_policy_route_cache_if_changed
        return 0
    fi

    if rebase_is_required; then
        degrade_until_managed_rebase
        return 1
    fi

    if mark_recorded_overlay_for_rebase; then
        degrade_until_managed_rebase
        return 1
    fi

    if owned_overlay_is_valid; then
        disable_vpn_fail_closed || {
            set_reconcile_error "policy precedence is ready, but VPN fail-closed could not be released"
            return 1
        }
        clear_reconcile_error
        flush_policy_route_cache_if_changed
        return 0
    fi

    ensure_vpn_fail_closed || {
        set_reconcile_error "could not protect VPN-policy traffic during route reconciliation"
        return 1
    }
    remove_owned_ip_rules || {
        set_reconcile_error "could not remove stale companion policy rules"
        return 1
    }
    ensure_policy_tables || {
        set_reconcile_error "companion direct or VPN table is not ready"
        return 1
    }

    if ! wait_for_native_rules_stable; then
        set_reconcile_error "Astrill native policy rules did not stabilize"
        return 1
    fi
    if install_owned_overlay; then
        if disable_vpn_fail_closed; then
            clear_reconcile_error
            flush_policy_route_cache_if_changed
            return 0
        fi
        set_reconcile_error \
            "policy precedence is ready, but VPN fail-closed could not be released"
        return 1
    fi
    if rebase_is_required; then
        set_reconcile_error "$REBASE_ERROR_MESSAGE"
    else
        set_reconcile_error "could not install companion rules ahead of Astrill native policy"
    fi
    return 1
}

runtime_policy_validate() {
    if [ "$(sed -n '1p' "$1")" = "# astrill-lazy-rules-v1" ]; then
        validate_rules "$1"
    else
        load_hybrid_helper && hybrid_validate_effective "$1"
    fi
}

compose_runtime_policy() {
    if load_hybrid_helper && [ "$(hybrid_overlay_count)" -gt 0 ]; then
        hybrid_compose_effective "$1" "$2"
    else
        cp "$1" "$2"
    fi
}

current_runtime_document() {
    initialize_rules || return 1
    if load_hybrid_helper && [ "$(hybrid_overlay_count)" -gt 0 ]; then
        runtime_effective=$BASE/effective.recompose.$$.tsv
        rm -f "$runtime_effective"
        hybrid_compose_effective "$CURRENT" "$runtime_effective" || {
            rm -f "$runtime_effective"
            return 1
        }
        runtime_hash=$(document_hash "$runtime_effective") || {
            rm -f "$runtime_effective"
            return 1
        }
        effective_hash=
        if [ -f "$EFFECTIVE" ] &&
           hybrid_validate_effective "$EFFECTIVE"; then
            effective_hash=$(document_hash "$EFFECTIVE") || effective_hash=
        fi
        if [ "$runtime_hash" = "$effective_hash" ]; then
            rm -f "$runtime_effective"
        else
            mv "$runtime_effective" "$EFFECTIVE" || {
                rm -f "$runtime_effective"
                return 1
            }
        fi
        printf '%s\n' "$EFFECTIVE"
    else
        printf '%s\n' "$CURRENT"
    fi
}

policy_chain_reference_count() {
    reference_chain=$1
    reference_rules=$(iptables -w 10 -t mangle -S 2>/dev/null) || return 1
    printf '%s\n' "$reference_rules" | awk -v chain="$reference_chain" '
        {
            for (field = 1; field < NF; field++) {
                if (($field == "-j" || $field == "-g") &&
                    $(field + 1) == chain) references++
            }
        }
        END { print references + 0 }
    '
}

discard_policy_chain() {
    discard_chain=$1
    discard_references=$(policy_chain_reference_count "$discard_chain") ||
        return 1
    [ "$discard_references" -eq 0 ] || return 1
    discard_hash_file=$(chain_document_hash_file "$discard_chain") ||
        discard_hash_file=
    [ -z "$discard_hash_file" ] || rm -f "$discard_hash_file"
}

apply_runtime() {
    file=$1
    refresh_mode=${2:-0}
    runtime_resolved_candidate=
    runtime_unresolved_candidate=
    previous_runtime_chain=$(active_chain)
    next_chain=$(inactive_chain)
    next_hash_file=$(chain_document_hash_file "$next_chain") || return 1
    next_document_hash=$(document_hash "$file") || return 1
    rm -f "$next_hash_file" "$next_hash_file.new.$$"
    build_chain "$next_chain" "$file" "$refresh_mode" || {
        discard_policy_chain "$next_chain" >/dev/null 2>&1 || true
        log_message ERROR "could not build policy chain $next_chain"
        return 1
    }
    printf '%s\n' "$next_document_hash" > "$next_hash_file.new.$$" || {
        rm -f "$runtime_resolved_candidate" "$runtime_unresolved_candidate"
        discard_policy_chain "$next_chain" >/dev/null 2>&1 || true
        return 1
    }
    mv "$next_hash_file.new.$$" "$next_hash_file" || {
        rm -f "$runtime_resolved_candidate" "$runtime_unresolved_candidate"
        discard_policy_chain "$next_chain" >/dev/null 2>&1 || true
        return 1
    }
    ensure_routes || {
        rm -f "$runtime_resolved_candidate" "$runtime_unresolved_candidate"
        discard_policy_chain "$next_chain" >/dev/null 2>&1 || true
        return 1
    }
    if ! activate_chain "$next_chain"; then
        rm -f "$runtime_resolved_candidate" "$runtime_unresolved_candidate"
        if activate_chain "$previous_runtime_chain"; then
            discard_policy_chain "$next_chain" >/dev/null 2>&1 || true
        else
            set_reconcile_error \
                "policy activation failed and the previous chain could not be restored"
        fi
        return 1
    fi
    if [ -n "$runtime_resolved_candidate" ] &&
       { ! mv "$runtime_unresolved_candidate" "$UNRESOLVED" ||
         ! mv "$runtime_resolved_candidate" "$RESOLVED"; }; then
        rm -f "$runtime_resolved_candidate" "$runtime_unresolved_candidate"
        activate_chain "$previous_runtime_chain" >/dev/null 2>&1 ||
            set_reconcile_error \
                "resolved-domain publication failed and the previous chain could not be restored"
        return 1
    fi
    date +%s > "$BASE/last-apply"
    return 0
}

apply_file() {
    candidate=$1
    generation=$(cat "$CORE_GENERATION_FILE" 2>/dev/null || printf 1)
    is_uint "$generation" || generation=1
    load_hybrid_helper || {
        printf 'RAM transaction helper is required for a safe core write\n' >&2
        return 1
    }
    hybrid_apply_core_file "$candidate" "$generation"
}

ensure_runtime() {
    if [ -f "$POLICY_TRANSACTION_FILE" ]; then
        load_hybrid_helper &&
            hybrid_recover_interrupted_transaction || return 1
    fi
    initialize_rules
    runtime_document=$(current_runtime_document) || return 1
    runtime_policy_validate "$runtime_document" || return 1
    runtime_document_hash=$(document_hash "$runtime_document") || return 1
    ensure_routes || return 1
    active=$(active_chain)
    active_hash_file=$(chain_document_hash_file "$active") || return 1
    active_document_hash=$(cat "$active_hash_file" 2>/dev/null || true)
    active_other=$CHAIN_A
    [ "$active" = "$CHAIN_A" ] && active_other=$CHAIN_B
    active_jump_count=$(prerouting_jump_count "$active") ||
        active_jump_count=-1
    other_jump_count=$(prerouting_jump_count "$active_other") ||
        other_jump_count=-1
    first_jump=$(first_prerouting_rule) || first_jump=
    if ! chain_exists "$active" ||
       [ "$active_document_hash" != "$runtime_document_hash" ] ||
       [ "$active_jump_count" -ne 1 ] ||
       [ "$other_jump_count" -ne 0 ] ||
       [ "$first_jump" != "-A PREROUTING -j $active" ]; then
        apply_runtime "$runtime_document" || return 1
        active=$(active_chain)
    fi
    ensure_app_runtime || return 1
}

cleanup_policy() {
    cleanup_failed=false
    iptables -w 10 -t mangle -S >/dev/null 2>&1 ||
        cleanup_failed=true
    iptables -w 10 -t filter -S >/dev/null 2>&1 ||
        cleanup_failed=true
    ip rule show >/dev/null 2>&1 || cleanup_failed=true
    cleanup_app_chain || cleanup_failed=true
    remove_prerouting_jump "$CHAIN_A" || cleanup_failed=true
    remove_prerouting_jump "$CHAIN_B" || cleanup_failed=true
    for chain in "$CHAIN_A" "$CHAIN_B"; do
        if chain_exists "$chain"; then
            iptables -w 10 -t mangle -F "$chain" 2>/dev/null ||
                cleanup_failed=true
            iptables -w 10 -t mangle -X "$chain" 2>/dev/null ||
                cleanup_failed=true
        fi
    done
    remove_vpn_fail_closed_jump 2>/dev/null || cleanup_failed=true
    if filter_chain_exists "$VPN_FAIL_CHAIN"; then
        iptables -w 10 -t filter -F "$VPN_FAIL_CHAIN" 2>/dev/null ||
            cleanup_failed=true
        iptables -w 10 -t filter -X "$VPN_FAIL_CHAIN" 2>/dev/null ||
            cleanup_failed=true
    fi
    for cleanup_pref in $(rule_prefs_for_signature "$DIRECT_MARK" "$DIRECT_TABLE"); do
        remove_exact_ip_rule "$cleanup_pref" "$DIRECT_MARK" "$DIRECT_TABLE" ||
            cleanup_failed=true
    done
    for cleanup_pref in $(rule_prefs_for_signature "$VPN_MARK" "$VPN_TABLE"); do
        remove_exact_ip_rule "$cleanup_pref" "$VPN_MARK" "$VPN_TABLE" ||
            cleanup_failed=true
    done
    for table in "$DIRECT_TABLE" "$VPN_TABLE"; do
        ip route flush table "$table" 2>/dev/null || cleanup_failed=true
    done

    for chain in "$CHAIN_A" "$CHAIN_B"; do
        iptables -w 10 -t mangle -C PREROUTING -j "$chain" \
            >/dev/null 2>&1 && cleanup_failed=true
        chain_exists "$chain" && cleanup_failed=true
    done
    iptables -w 10 -t filter -C FORWARD -j "$VPN_FAIL_CHAIN" \
        >/dev/null 2>&1 && cleanup_failed=true
    filter_chain_exists "$VPN_FAIL_CHAIN" && cleanup_failed=true
    iptables -w 10 -t mangle -S >/dev/null 2>&1 ||
        cleanup_failed=true
    iptables -w 10 -t filter -S >/dev/null 2>&1 ||
        cleanup_failed=true
    ip rule show >/dev/null 2>&1 || cleanup_failed=true
    if [ "$(owned_rule_count)" -eq 0 ]; then
        rm -f "$RPDB_PREFS_FILE"
    else
        cleanup_failed=true
    fi
    for table in "$DIRECT_TABLE" "$VPN_TABLE"; do
        cleanup_routes=$(ip route show table "$table" 2>/dev/null) ||
            cleanup_failed=true
        cleanup_route_count=$(
            printf '%s\n' "$cleanup_routes" |
                awk 'NF { count++ } END { print count + 0 }'
        )
        [ "$cleanup_route_count" -eq 0 ] || cleanup_failed=true
    done

    rm -f "$RECONCILE_ERROR_FILE" "$REBASE_REQUIRED_FILE"
    ip route flush cache 2>/dev/null || true
    rm -f "$APP_FLOWS"
    [ "$cleanup_failed" = false ]
}

watchdog_running() {
    pid=$(cat "$WATCHDOG_PID" 2>/dev/null || printf 0)
    is_live_pid "$pid" || return 1
    watchdog_pids | grep -qx "$pid"
}

watchdog_pids() {
    ps w | awk '$0 ~ /\/tmp\/astrill-lazy\/alctl watchdog-loop[[:space:]]*$/ { print $1 }'
}

start_watchdog() {
    watchdog_running && return 0
    existing_pid=$(watchdog_pids | head -n 1)
    if is_live_pid "$existing_pid"; then
        printf '%s\n' "$existing_pid" > "$WATCHDOG_PID"
        return 0
    fi
    "$0" watchdog-loop >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$WATCHDOG_PID"
}

stop_watchdog() {
    for pid in $(watchdog_pids); do
        if is_live_pid "$pid"; then
            kill "$pid" 2>/dev/null || true
        fi
    done
    attempts=0
    while [ -n "$(watchdog_pids)" ] && [ "$attempts" -lt 2 ]; do
        attempts=$((attempts + 1))
        sleep 1
    done
    for pid in $(watchdog_pids); do
        kill -9 "$pid" 2>/dev/null || true
    done
    attempts=0
    while [ -n "$(watchdog_pids)" ] && [ "$attempts" -lt 3 ]; do
        attempts=$((attempts + 1))
        sleep 1
    done
    [ -z "$(watchdog_pids)" ] || return 1
    rm -f "$WATCHDOG_PID"
}

cleanup_watchdog_pid() {
    recorded_pid=$(cat "$WATCHDOG_PID" 2>/dev/null || printf 0)
    [ "$recorded_pid" != "$$" ] || rm -f "$WATCHDOG_PID"
}

cleanup_watchdog() {
    if is_live_pid "${watchdog_sleep_pid:-0}"; then
        kill "$watchdog_sleep_pid" 2>/dev/null || true
    fi
    cleanup_hybrid_runtime \
        "interrupted watchdog runtime metadata could not be restored" || true
    release_watchdog_lock
    cleanup_watchdog_pid
}

try_watchdog_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCK_DIR/pid"
        return 0
    fi

    watchdog_lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || printf 0)
    is_live_pid "$watchdog_lock_pid" && return 1

    sleep 1
    watchdog_lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || printf 0)
    is_live_pid "$watchdog_lock_pid" && return 1
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || return 1
    mkdir "$LOCK_DIR" 2>/dev/null || return 1
    printf '%s\n' "$$" > "$LOCK_DIR/pid"
    return 0
}

release_watchdog_lock() {
    watchdog_lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || printf 0)
    [ "$watchdog_lock_pid" = "$$" ] || return 0
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

watchdog_loop() {
    watchdog_sleep_pid=0
    trap 'cleanup_watchdog; trap - HUP INT TERM EXIT; exit 0' \
        HUP INT TERM EXIT
    cycles=0
    while :; do
        if try_watchdog_lock; then
            ensure_runtime >/dev/null 2>&1 || true
            cycles=$((cycles + 1))
            if [ "$cycles" -ge "$WATCHDOG_REFRESH_CYCLES" ]; then
                if load_hybrid_helper &&
                   [ "$(hybrid_overlay_count)" -gt 0 ]; then
                    cycles=0
                else
                    refresh_document=$(current_runtime_document)
                    if [ -n "$refresh_document" ] &&
                       runtime_policy_validate "$refresh_document" &&
                       apply_runtime "$refresh_document" 1; then
                        log_message INFO \
                            "watchdog refreshed resolved domains and policy routes"
                    else
                        if rebase_is_required; then
                            set_reconcile_error "$REBASE_ERROR_MESSAGE"
                        else
                            set_reconcile_error \
                                "watchdog could not refresh resolved domains and policy routes"
                        fi
                    fi
                    cycles=0
                fi
            fi
            release_watchdog_lock
        fi
        sleep "$WATCHDOG_INTERVAL" &
        watchdog_sleep_pid=$!
        wait "$watchdog_sleep_pid" 2>/dev/null || true
        watchdog_sleep_pid=0
    done
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]/?/g'
}

print_layered_status() {
    if load_hybrid_helper; then
        hybrid_print_layered_status
        return
    fi
    core_hash=$(document_hash "$CURRENT") || return 1
    core_bytes=$(wc -c < "$CURRENT")
    printf ',"runtime_epoch":"%s"' "$(cat "$RUNTIME_EPOCH_FILE")"
    printf ',"core":{"generation":%s,"hash":"%s"' \
        "$(cat "$CORE_GENERATION_FILE" 2>/dev/null || printf 1)" "$core_hash"
    printf ',"origins":%s,"rows":%s,"bytes":%s}' \
        "$origin_count" "$compiled_count" "$core_bytes"
    printf ',"overlays":[]'
    printf ',"effective":{"hash":"%s","rows":%s,"bytes":%s' \
        "$core_hash" "$compiled_count" "$core_bytes"
    printf ',"generated_matches":null}'
}

app_flows_json() {
    initialize_app_flows
    validate_app_flows "$APP_FLOWS" || fail "stored application flows are invalid"
    count=$(wc -l < "$APP_FLOWS" 2>/dev/null || printf 0)
    printf '{"ok":true,"count":%s,"flows":[' "$count"
    first=true
    while IFS="$TAB" read -r id source protocol ports target; do
        [ "$first" = true ] || printf ','
        first=false
        printf '{"id":"%s","source":"%s","protocol":"%s"' \
            "$id" "$source" "$protocol"
        printf ',"source_ports":"%s","target":"%s"}' "$ports" "$target"
    done < "$APP_FLOWS"
    printf ']}\n'
}

status_json() {
    initialize_rules
    initialize_app_flows
    active=$(active_chain)
    version=$(cat "$VERSION_FILE" 2>/dev/null || printf unknown)
    package_md5=$(cat "$PACKAGE_MD5_FILE" 2>/dev/null || true)
    stored_package_md5=$(nvram get astrill_lazy_pkg_md5)
    helper_md5=$(md5sum "$HYBRID_HELPER" 2>/dev/null | awk '{print $1}')
    case $package_md5 in
        ''|*[!0-9a-fA-F]*) package_md5_json=null ;;
        *)
            if [ "${#package_md5}" -eq 32 ]; then
                package_md5_json="\"$(printf '%s' "$package_md5" | tr 'A-F' 'a-f')\""
            else
                package_md5_json=null
            fi
            ;;
    esac
    case $stored_package_md5 in
        ''|*[!0-9a-fA-F]*) stored_package_md5_json=null ;;
        *)
            if [ "${#stored_package_md5}" -eq 32 ]; then
                stored_package_md5_json="\"$(printf '%s' \
                    "$stored_package_md5" | tr 'A-F' 'a-f')\""
            else
                stored_package_md5_json=null
            fi
            ;;
    esac
    case $helper_md5 in
        ''|*[!0-9a-fA-F]*) helper_md5_json=null ;;
        *)
            if [ "${#helper_md5}" -eq 32 ]; then
                helper_md5_json="\"$(printf '%s' "$helper_md5" |
                    tr 'A-F' 'a-f')\""
            else
                helper_md5_json=null
            fi
            ;;
    esac
    package_identity_ok=false
    if [ "$package_md5_json" != null ] &&
       [ "$package_md5_json" = "$stored_package_md5_json" ] &&
       [ "$(nvram get astrill_lazy_installed)" = 1 ] &&
       [ "$(nvram get astrill_lazy_version)" = "$version" ]; then
        package_identity_ok=true
    fi
    compiled_count=$(awk -F '\t' '$0 !~ /^#/ && NF == 10 { count++ } END { print count + 0 }' "$CURRENT")
    origin_count=$(awk -F '\t' '$0 !~ /^#/ && NF == 10 && !seen[$10]++ { count++ } END { print count + 0 }' "$CURRENT")
    enabled_origin_count=$(awk -F '\t' '$0 !~ /^#/ && NF == 10 && $2 == 1 && !seen[$10]++ { count++ } END { print count + 0 }' "$CURRENT")
    direct_count=$(awk -F '\t' '$2 == 1 && $6 == "direct" { count++ } END { print count + 0 }' "$CURRENT")
    vpn_count=$(awk -F '\t' '$2 == 1 && $6 == "vpn" { count++ } END { print count + 0 }' "$CURRENT")
    resolved_count=$(wc -l < "$RESOLVED" 2>/dev/null || printf 0)
    unresolved_count=$(wc -l < "$UNRESOLVED" 2>/dev/null || printf 0)
    app_flow_count=$(wc -l < "$APP_FLOWS" 2>/dev/null || printf 0)
    last_apply=$(cat "$BASE/last-apply" 2>/dev/null || printf 0)
    astrill_status=$(nvram get astrill_status)
    astrill_server=$(nvram get astrill_serverid)
    astrill_protocol=$(nvram get astrill_protocol)
    wan_iface=$(nvram get wan_iface)
    vpn_state=down
    tunnel_is_up && vpn_state=up
    watchdog=false
    watchdog_running && watchdog=true
    jump=false
    iptables -w 10 -t mangle -C PREROUTING -j "$active" >/dev/null 2>&1 && jump=true
    app_jump=false
    iptables -w 10 -t mangle -C PREROUTING -j "$APP_CHAIN" >/dev/null 2>&1 &&
        app_jump=true
    direct_table_ready=false
    direct_table_is_ready && direct_table_ready=true
    vpn_table_ready=false
    vpn_table_is_ready && vpn_table_ready=true
    vpn_fail_closed=false
    vpn_fail_closed_is_ready && vpn_fail_closed=true
    rebase_required=false
    rebase_is_required && rebase_required=true
    current_native_pref=$(native_min_pref)
    current_direct_pref=$(current_owned_pref "$DIRECT_MARK" "$DIRECT_TABLE")
    current_vpn_pref=$(current_owned_pref "$VPN_MARK" "$VPN_TABLE")
    native_table_ready=false
    if [ "$vpn_state" = up ] && is_uint "$current_native_pref"; then
        native_table_ready=true
    fi
    native_pref_json=null
    direct_pref_json=null
    vpn_pref_json=null
    is_uint "$current_native_pref" && native_pref_json=$current_native_pref
    is_uint "$current_direct_pref" && direct_pref_json=$current_direct_pref
    is_uint "$current_vpn_pref" && vpn_pref_json=$current_vpn_pref
    precedence_ok=false
    if [ "$vpn_state" = up ]; then
        if load_owned_pref_state &&
           is_uint "$current_native_pref" &&
           [ "$current_direct_pref" = "$owned_direct_pref" ] &&
           [ "$current_vpn_pref" = "$owned_vpn_pref" ] &&
           [ "$owned_vpn_pref" -lt "$current_native_pref" ] &&
           [ "$vpn_fail_closed" = false ]; then
            precedence_ok=true
        fi
    elif [ "$(owned_rule_count)" -eq 0 ] &&
         [ "$vpn_fail_closed" = true ]; then
        precedence_ok=true
    fi
    last_reconcile_error=$(cat "$RECONCILE_ERROR_FILE" 2>/dev/null || true)
    core_recovery=$(cat "$CORE_RECOVERY_FILE" 2>/dev/null || true)
    if [ -n "$core_recovery" ] && [ -z "$last_reconcile_error" ]; then
        last_reconcile_error=$core_recovery
    fi
    policy_health=ready
    [ "$jump" = true ] || policy_health=degraded
    [ "$direct_table_ready" = true ] || policy_health=degraded
    [ "$vpn_table_ready" = true ] || policy_health=degraded
    [ "$precedence_ok" = true ] || policy_health=degraded
    [ "$package_identity_ok" = true ] || policy_health=degraded
    if [ "$vpn_state" = up ]; then
        [ "$native_table_ready" = true ] || policy_health=degraded
    fi
    [ -z "$last_reconcile_error" ] || policy_health=degraded
    if [ "$policy_health" = degraded ] && [ -z "$last_reconcile_error" ]; then
        last_reconcile_error="policy runtime has not been fully reconciled"
    fi
    health=healthy
    [ "$watchdog" = true ] || health=degraded
    [ "$policy_health" = ready ] || health=degraded
    [ "$app_flow_count" -eq 0 ] || [ "$app_jump" = true ] || health=degraded
    rollback_available=false
    [ -f "$PREVIOUS" ] && rollback_available=true
    rollback_persistent=false
    if [ -n "$(nvram get "$PREVIOUS_RULES_KEY")" ] ||
       [ -n "$(nvram get "$PREVIOUS_RULES_GZ_KEY")" ]; then
        rollback_persistent=true
    fi

    printf '{'
    printf '"schema_version":1,"ok":true'
    printf ',"version":"%s","health":"%s"' "$(json_escape "$version")" "$health"
    printf ',"package_md5":%s,"stored_package_md5":%s' \
        "$package_md5_json" "$stored_package_md5_json"
    printf ',"helper_md5":%s' "$helper_md5_json"
    printf ',"package_identity_ok":%s' "$package_identity_ok"
    printf ',"vpn_state":"%s","astrill_status":%s' "$vpn_state" "${astrill_status:-0}"
    printf ',"astrill_server_id":%s,"astrill_protocol":%s' "${astrill_server:-0}" "${astrill_protocol:-0}"
    printf ',"wan_interface":"%s","active_chain":"%s"' "$(json_escape "$wan_iface")" "$active"
    printf ',"watchdog":%s,"jump_installed":%s' "$watchdog" "$jump"
    printf ',"app_flow_count":%s,"app_jump_installed":%s' \
        "$app_flow_count" "$app_jump"
    printf ',"rollback_available":%s,"rollback_persistent":%s' \
        "$rollback_available" "$rollback_persistent"
    printf ',"policy_health":"%s","precedence_ok":%s' \
        "$policy_health" "$precedence_ok"
    printf ',"native_min_pref":%s,"direct_pref":%s,"vpn_pref":%s' \
        "$native_pref_json" "$direct_pref_json" "$vpn_pref_json"
    printf ',"table_readiness":{"direct":%s,"vpn":%s,"native":%s}' \
        "$direct_table_ready" "$vpn_table_ready" "$native_table_ready"
    printf ',"vpn_fail_closed":%s' "$vpn_fail_closed"
    printf ',"rebase_required":%s' "$rebase_required"
    if [ -n "$core_recovery" ]; then
        printf ',"core_recovery":"%s"' "$(json_escape "$core_recovery")"
    else
        printf ',"core_recovery":null'
    fi
    if [ -n "$last_reconcile_error" ]; then
        printf ',"last_reconcile_error":"%s"' \
            "$(json_escape "$last_reconcile_error")"
    else
        printf ',"last_reconcile_error":null'
    fi
    printf ',"rules_count":%s,"origin_count":%s,"enabled_origin_count":%s' \
        "$compiled_count" "$origin_count" "$enabled_origin_count"
    printf ',"direct_rules":%s,"vpn_rules":%s' "$direct_count" "$vpn_count"
    printf ',"resolved_addresses":%s,"unresolved_domains":%s' "$resolved_count" "$unresolved_count"
    printf ',"last_apply":%s' "$last_apply"
    print_layered_status || fail "status failed"
    printf ',"rules":['
    first=true
    while IFS="$TAB" read -r id enabled priority kind selector target protocol ports label origin; do
        case $id in ''|\#*) continue ;; esac
        [ "$first" = true ] || printf ','
        first=false
        [ "$enabled" = 1 ] && enabled_json=true || enabled_json=false
        printf '{"id":"%s","enabled":%s,"priority":%s' "$id" "$enabled_json" "$priority"
        printf ',"kind":"%s","selector":"%s","target":"%s"' "$kind" "$selector" "$target"
        printf ',"protocol":"%s","ports":"%s","label":"%s","origin":"%s"}' "$protocol" "$ports" "$label" "$origin"
    done < "$CURRENT"
    printf ']}\n'
}

clients_json() {
    raw=$BASE/clients.$$.raw.tsv
    merged=$BASE/clients.$$.merged.tsv
    : > "$raw"

    if [ -f "$LEASES_FILE" ]; then
        while read -r expires mac address hostname _client_id; do
            valid_ipv4_network "${address:-}" || continue
            valid_mac "${mac:-}" || continue
            is_uint "${expires:-}" || expires=0
            printf '%s\t%s\t%s\t%s\tdhcp\tfalse\n' \
                "$address" "$(printf '%s' "$mac" | tr 'A-F' 'a-f')" \
                "${hostname:-unknown}" "$expires" >> "$raw"
        done < "$LEASES_FILE"
    fi

    for key in static_leases dhcp_staticlist dhcpd_static; do
        static_value=$(nvram get "$key")
        [ -n "$static_value" ] || continue
        printf '%s\n' "$static_value" |
            tr '<>' '\n' |
            tr ' ' '\n' |
            while IFS='=' read -r mac hostname address _lease; do
                valid_ipv4_network "${address:-}" || continue
                valid_mac "${mac:-}" || continue
                printf '%s\t%s\t%s\t0\tstatic\tfalse\n' \
                    "$address" "$(printf '%s' "$mac" | tr 'A-F' 'a-f')" \
                    "${hostname:-unknown}" >> "$raw"
            done
    done

    lan_interface=$(nvram get lan_ifname)
    [ -n "$lan_interface" ] || lan_interface=br0
    if [ -f "$ARP_FILE" ]; then
        awk -v interface="$lan_interface" '
            NR > 1 && ($3 == "0x2" || $3 == "0X2") && $6 == interface {
                print $1 "\t" tolower($4) "\tunknown\t0\tarp\ttrue"
            }
        ' "$ARP_FILE" >> "$raw"
    fi

    awk -F '\t' -v OFS='\t' '
        function known_name(value) {
            return value != "" && value != "*" && value != "unknown"
        }
        {
            mac = tolower($2)
            key = mac != "" ? "mac:" mac : "ip:" $1
            if (!(key in seen)) {
                seen[key] = 1
                order[++count] = key
                addresses[key] = $1
                macs[key] = mac
                names[key] = $3
                expiries[key] = $4 + 0
                sources[key] = $5
                active[key] = $6
                next
            }
            if ($6 == "true") {
                addresses[key] = $1
                active[key] = "true"
            }
            if (($5 == "static" || !known_name(names[key])) && known_name($3)) {
                names[key] = $3
            }
            if (($4 + 0) > expiries[key]) {
                expiries[key] = $4 + 0
            }
            if (index("," sources[key] ",", "," $5 ",") == 0) {
                sources[key] = sources[key] "," $5
            }
        }
        END {
            for (position = 1; position <= count; position++) {
                key = order[position]
                print addresses[key], macs[key], names[key], expiries[key],
                    sources[key], active[key]
            }
        }
    ' "$raw" > "$merged" || {
        rm -f "$raw" "$merged"
        fail "could not merge LAN device inventory"
    }

    printf '['
    first=true
    while IFS="$TAB" read -r address mac hostname expires source active; do
        [ -n "${address:-}" ] || continue
        [ "$first" = true ] || printf ','
        first=false
        [ "$active" = true ] || active=false
        printf '{"address":"%s","mac":"%s","hostname":"%s","expires":%s' \
            "$(json_escape "$address")" "$(json_escape "$mac")" \
            "$(json_escape "${hostname:-unknown}")" "${expires:-0}"
        printf ',"source":"%s","active":%s}' "$(json_escape "$source")" "$active"
    done < "$merged"
    printf ']\n'
    rm -f "$raw" "$merged"
}

transform_origin() {
    operation=$1
    origin=$2
    value=${3:-}
    valid_id "$origin" || fail "invalid origin id"
    initialize_rules
    grep -q "${TAB}${origin}\$" "$CURRENT" || fail "rule origin not found: $origin"
    candidate=$BASE/rules.transform.tsv
    case $operation in
        toggle)
            if awk -F '\t' -v origin="$origin" '$10 == origin && $2 == 1 { found=1 } END { exit !found }' "$CURRENT"; then
                next_enabled=0
            else
                next_enabled=1
            fi
            awk -F '\t' -v OFS='\t' -v origin="$origin" -v enabled="$next_enabled" \
                '$10 == origin { $2 = enabled } { print }' "$CURRENT" > "$candidate"
            ;;
        route)
            case $value in direct|vpn) ;; *) fail "route target must be direct or vpn" ;; esac
            awk -F '\t' -v OFS='\t' -v origin="$origin" -v target="$value" \
                '$10 == origin { $6 = target } { print }' "$CURRENT" > "$candidate"
            ;;
        *) fail "unknown origin transform" ;;
    esac
    apply_file "$candidate" || fail "could not apply transformed rules"
    rm -f "$candidate"
}

switch_astrill() {
    server_id=${1:-}
    sid=${2:-}
    encoded_ip=${3:-}
    port=${4:-}
    port_index=${5:-}
    protocol=${6:-}
    vpn_mode=${7:-}
    for value in "$server_id" "$sid" "$port_index" "$protocol" "$vpn_mode"; do
        is_uint "$value" || fail "invalid Astrill server parameter"
    done
    case $encoded_ip in -*) numeric_ip=${encoded_ip#-} ;; *) numeric_ip=$encoded_ip ;; esac
    is_uint "$numeric_ip" || fail "invalid encoded Astrill address"
    case $port in ''|*[!0-9,:-]*) fail "invalid Astrill port" ;; esac
    if [ "$protocol" -lt 0 ] || [ "$protocol" -gt 3 ]; then
        fail "invalid Astrill protocol"
    fi
    [ -x /dev/astrill/astrillvpn ] || fail "Astrill applet is unavailable"

    initially_connected=false
    if [ "$(nvram get astrill_status)" = 3 ] &&
       ip route show table main | grep -q ' dev tun0'; then
        initially_connected=true
    fi

    prepare_for_astrill_start ||
        fail "could not safely remove companion policy rules before Astrill switch"

    rollback_file=$BASE/astrill-switch.previous
    : > "$rollback_file"
    for key in astrill_serverid astrill_sid astrill_ip astrill_port astrill_portindex astrill_protocol astrill_vpnmode; do
        printf '%s\t%s\n' "$key" "$(nvram get "$key")" >> "$rollback_file"
    done
    nvram set "astrill_serverid=$server_id"
    nvram set "astrill_sid=$sid"
    nvram set "astrill_ip=$encoded_ip"
    nvram set "astrill_port=$port"
    nvram set "astrill_portindex=$port_index"
    nvram set "astrill_protocol=$protocol"
    nvram set "astrill_vpnmode=$vpn_mode"
    /dev/astrill/astrillvpn start > "$BASE/astrill-switch.log" 2>&1 || true

    attempts=0
    while [ "$attempts" -lt "$ASTRILL_CONNECT_ATTEMPTS" ]; do
        if [ "$(nvram get astrill_status)" = 3 ] && ip route show table main | grep -q ' dev tun0'; then
            nvram commit >/dev/null
            if ! ensure_runtime >/dev/null 2>&1; then
                log_message WARN \
                    "Astrill switched successfully, but companion policy routing is degraded"
            fi
            rm -f "$rollback_file"
            log_message INFO "switched Astrill server to id $server_id"
            status_json
            return 0
        fi
        attempts=$((attempts + 1))
        sleep 1
    done

    while IFS="$TAB" read -r key value; do
        nvram set "$key=$value"
    done < "$rollback_file"
    nvram commit >/dev/null

    if ! prepare_for_astrill_stop; then
        rm -f "$rollback_file"
        fail "could not enable VPN-policy fail-closed; Astrill was not stopped after the failed switch"
    fi
    /dev/astrill/astrillvpn stop >> "$BASE/astrill-switch.log" 2>&1 || true
    attempts=0
    rollback_stopped=false
    while [ "$attempts" -lt 65 ]; do
        # shellcheck disable=SC2009
        if ! ip route show table main | grep -q ' dev tun0' &&
           ! ps w | grep astrill/openvpn.conf | grep -vq grep; then
            rollback_stopped=true
            break
        fi
        attempts=$((attempts + 1))
        sleep 1
    done

    rollback_verified=$rollback_stopped
    if [ "$initially_connected" = true ]; then
        rollback_connected=false
        if prepare_for_astrill_start; then
            /dev/astrill/astrillvpn start >> "$BASE/astrill-switch.log" 2>&1 || true
            attempts=0
            while [ "$attempts" -lt "$ASTRILL_CONNECT_ATTEMPTS" ]; do
                if [ "$(nvram get astrill_status)" = 3 ] &&
                   ip route show table main | grep -q ' dev tun0'; then
                    rollback_connected=true
                    break
                fi
                attempts=$((attempts + 1))
                sleep 1
            done
        else
            log_message ERROR \
                "could not prepare companion policy routing before Astrill rollback"
        fi
        rollback_verified=false
        if [ "$rollback_stopped" = true ] &&
           [ "$rollback_connected" = true ]; then
            rollback_verified=true
        fi
    fi

    rollback_policy_ready=true
    ensure_routes >/dev/null 2>&1 || {
        rollback_policy_ready=false
        log_message ERROR "could not reconcile policy routes after failed Astrill switch"
    }
    if [ "$rollback_verified" = true ]; then
        log_message WARN "failed Astrill switch restored the original connection state"
        rm -f "$rollback_file"
        if [ "$rollback_policy_ready" = false ]; then
            fail "new Astrill server did not connect; previous settings were restored, but policy routing is degraded"
        fi
        fail "new Astrill server did not connect; previous settings were restored"
    else
        log_message ERROR "failed Astrill switch could not verify the original connection state"
        rm -f "$rollback_file"
        fail "new Astrill server did not connect; previous connection state could not be verified"
    fi
}

restart_astrill_for_managed_rebase() {
    prepare_for_astrill_stop || return 1
    /dev/astrill/astrillvpn stop > "$BASE/astrill-rebase.log" 2>&1 || true
    rebase_stop_attempts=0
    while [ "$rebase_stop_attempts" -lt 65 ]; do
        # shellcheck disable=SC2009
        if ! ip route show table main | grep -q ' dev tun0' &&
           ! ps w | grep astrill/openvpn.conf | grep -vq grep; then
            break
        fi
        rebase_stop_attempts=$((rebase_stop_attempts + 1))
        sleep 1
    done
    [ "$rebase_stop_attempts" -lt 65 ] || return 1

    prepare_for_astrill_start || return 1
    /dev/astrill/astrillvpn start >> "$BASE/astrill-rebase.log" 2>&1 || true
    rebase_start_attempts=0
    while [ "$rebase_start_attempts" -lt "$ASTRILL_CONNECT_ATTEMPTS" ]; do
        if [ "$(nvram get astrill_status)" = 3 ] &&
           ip route show table main | grep -q ' dev tun0'; then
            return 0
        fi
        rebase_start_attempts=$((rebase_start_attempts + 1))
        sleep 1
    done
    return 1
}

set_astrill_connection() {
    requested=${1:-}
    [ -x /dev/astrill/astrillvpn ] || fail "Astrill applet is unavailable"

    case $requested in
        up)
            if [ "$(nvram get astrill_status)" = 3 ] &&
               ip route show table main | grep -q ' dev tun0'; then
                if rebase_is_required; then
                    if ! restart_astrill_for_managed_rebase; then
                        if tunnel_is_up; then
                            set_reconcile_error \
                                "managed policy rebase could not restart Astrill"
                            status_json
                            return 0
                        fi
                        fail "Astrill disconnected while attempting the managed policy rebase"
                    fi
                fi
                if ! ensure_runtime >/dev/null 2>&1; then
                    log_message WARN \
                        "Astrill is connected, but companion policy routing is degraded"
                fi
                status_json
                return 0
            fi
            prepare_for_astrill_start ||
                fail "could not safely remove companion policy rules before Astrill connect"
            /dev/astrill/astrillvpn start > "$BASE/astrill-connection.log" 2>&1 || true
            attempts=0
            while [ "$attempts" -lt "$ASTRILL_CONNECT_ATTEMPTS" ]; do
                if [ "$(nvram get astrill_status)" = 3 ] &&
                   ip route show table main | grep -q ' dev tun0'; then
                    if ! ensure_runtime >/dev/null 2>&1; then
                        log_message WARN \
                            "Astrill connected, but companion policy routing is degraded"
                    fi
                    log_message INFO "connected Astrill at user request"
                    status_json
                    return 0
                fi
                attempts=$((attempts + 1))
                sleep 1
            done
            fail "Astrill did not connect within $ASTRILL_CONNECT_ATTEMPTS seconds"
            ;;
        down)
            prepare_for_astrill_stop ||
                fail "could not enable VPN-policy fail-closed before Astrill disconnect"
            /dev/astrill/astrillvpn stop > "$BASE/astrill-connection.log" 2>&1 || true
            attempts=0
            while [ "$attempts" -lt 65 ]; do
                # shellcheck disable=SC2009
                if ! ip route show table main | grep -q ' dev tun0' &&
                   ! ps w | grep astrill/openvpn.conf | grep -vq grep; then
                    if ! ensure_runtime >/dev/null 2>&1; then
                        log_message WARN \
                            "Astrill disconnected, but companion fail-closed policy is degraded"
                    fi
                    log_message INFO "disconnected Astrill at user request"
                    status_json
                    return 0
                fi
                attempts=$((attempts + 1))
                sleep 1
            done
            fail "Astrill did not disconnect within 65 seconds"
            ;;
        *)
            fail "Astrill connection state must be up or down"
            ;;
    esac
}

usage() {
    cat <<'EOF'
Usage: alctl COMMAND
status rules validate-persisted-core effective-status apply core-apply rollback
core-rollback refresh overlay-put overlay-remove overlay-list toggle-origin
route-origin app-flow clients astrill-switch astrill-connect astrill-disconnect
ensure start stop logs version
Writes require package/helper identity and generation; use the desktop app.
core-apply VERSION PACKAGE_MD5 HELPER_MD5 GENERATION FILE|-
overlay-put VERSION PACKAGE_MD5 HELPER_MD5 OWNER GENERATION SOURCE EXPECTED_SOURCE EXPECTED_MAC FILE|-
EOF
}

command=${1:-}
case $command in
    status)
        status_json
        ;;
    rules)
        initialize_rules
        cat "$CURRENT"
        ;;
    validate-persisted-core)
        case ${2:-} in
            '') persisted_json=false ;;
            --json) persisted_json=true ;;
            *) fail "validate-persisted-core accepts only --json" ;;
        esac
        acquire_lock
        validate_persisted_core "$persisted_json" ||
            exit 1
        ;;
    apply)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        source=${5:--}
        candidate=$BASE/core.candidate.$$.tsv
        if [ "$source" = "-" ]; then
            cat > "$candidate"
        else
            [ -f "$source" ] || fail "rule file was not found: $source"
            cp "$source" "$candidate"
        fi
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        initialize_rules
        apply_file "$candidate" || fail "rule validation or policy activation failed"
        rm -f "$candidate"
        status_json
        ;;
    core-apply)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        expected=${5:-}
        is_uint "$expected" ||
            fail "core-apply requires the expected core generation"
        source=${6:--}
        candidate=$BASE/core.candidate.$$.tsv
        if [ "$source" = "-" ]; then
            cat > "$candidate"
        else
            [ -f "$source" ] || fail "rule file was not found: $source"
            cp "$source" "$candidate"
        fi
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        initialize_rules
        load_hybrid_helper || fail "helper missing"
        hybrid_apply_core_file "$candidate" "$expected" ||
            fail "core generation, validation, persistence, or activation failed"
        rm -f "$candidate"
        status_json
        ;;
    refresh)
        acquire_lock
        refresh_document=$(current_runtime_document) ||
            fail "invalid policy"
        runtime_policy_validate "$refresh_document" ||
            fail "invalid effective policy"
        apply_runtime "$refresh_document" 1 || fail "could not refresh policy"
        log_message INFO "refreshed resolved domains and policy routes"
        status_json
        ;;
    rollback)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        initialize_rules
        [ -f "$PREVIOUS" ] || fail "no previous rule document is available"
        candidate=$BASE/rules.rollback.tsv
        cp "$PREVIOUS" "$candidate"
        apply_file "$candidate" || fail "could not roll back rules"
        rm -f "$candidate"
        status_json
        ;;
    core-rollback)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        expected=${5:-}
        is_uint "$expected" ||
            fail "core-rollback requires the expected core generation"
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        initialize_rules
        [ -f "$PREVIOUS" ] || fail "no previous rule document is available"
        candidate=$BASE/rules.rollback.$$.tsv
        cp "$PREVIOUS" "$candidate"
        load_hybrid_helper || fail "helper missing"
        hybrid_apply_core_file "$candidate" "$expected" ||
            fail "core generation changed or rollback failed"
        rm -f "$candidate"
        status_json
        ;;
    overlay-put)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        owner=${5:-}
        expected=${6:-}
        source_scope=${7:-auto}
        expected_source=${8:--}
        expected_mac=${9:--}
        overlay_source=${10:--}
        overlay_candidate=$BASE/overlay.candidate.$$.tsv
        if [ "$overlay_source" = "-" ]; then
            cat > "$overlay_candidate"
        else
            [ -f "$overlay_source" ] ||
                fail "overlay file was not found: $overlay_source"
            cp "$overlay_source" "$overlay_candidate"
        fi
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        initialize_rules
        load_hybrid_helper ||
            fail "helper missing"
        hybrid_put_overlay \
            "$owner" "$expected" "$source_scope" "$overlay_candidate" \
            "$expected_source" "$expected_mac" ||
            fail "overlay apply failed"
        rm -f "$overlay_candidate"
        status_json
        ;;
    overlay-remove)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        initialize_rules
        load_hybrid_helper ||
            fail "helper missing"
        hybrid_remove_overlay "${5:-}" "${6:-}" ||
            fail "overlay remove failed"
        status_json
        ;;
    overlay-list|effective-status)
        status_json
        ;;
    toggle-origin)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        transform_origin toggle "${5:-}"
        status_json
        ;;
    route-origin)
        expected_version=${2:-}
        expected_md5=${3:-}
        expected_helper_md5=${4:-}
        acquire_lock
        require_package_identity "$expected_version" "$expected_md5" ||
            fail "package identity precondition failed"
        require_hybrid_helper_identity "$expected_helper_md5" ||
            fail "helper identity precondition failed"
        transform_origin route "${5:-}" "${6:-}"
        status_json
        ;;
    app-flow)
        operation=${2:-list}
        case $operation in
            list)
                app_flows_json
                ;;
            set)
                acquire_lock
                ensure_runtime || fail "could not repair policy runtime"
                transform_app_flow \
                    set "${3:-}" "${4:-}" "${5:-}" "${6:-}" "${7:-}"
                log_message INFO "updated transient application flow ${3:-}"
                app_flows_json
                ;;
            delete)
                acquire_lock
                ensure_runtime || fail "could not repair policy runtime"
                transform_app_flow delete "${3:-}"
                log_message INFO "deleted transient application flow ${3:-}"
                app_flows_json
                ;;
            *)
                fail "app-flow operation must be list, set, or delete"
                ;;
        esac
        ;;
    clients)
        clients_json
        ;;
    astrill-switch)
        shift
        acquire_lock
        switch_astrill "$@"
        ;;
    astrill-connect)
        acquire_lock
        set_astrill_connection up
        ;;
    astrill-disconnect)
        acquire_lock
        set_astrill_connection down
        ;;
    ensure)
        acquire_lock
        ensure_runtime || fail "could not repair policy runtime"
        ;;
    start)
        acquire_lock
        ensure_runtime || fail "could not start policy runtime"
        start_watchdog
        log_message INFO "controller started"
        status_json
        ;;
    stop)
        acquire_lock
        stop_watchdog || fail "could not stop the watchdog"
        cleanup_policy ||
            fail "could not completely remove the companion policy runtime"
        log_message INFO "controller stopped"
        ;;
    watchdog-loop)
        watchdog_loop
        ;;
    logs)
        tail -n 200 "$LOG_FILE" 2>/dev/null || true
        ;;
    version)
        cat "$VERSION_FILE" 2>/dev/null || printf 'unknown\n'
        ;;
    ''|-h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
